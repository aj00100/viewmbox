---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  schema?: Record<string, unknown>;
}

const { title, description, canonicalPath = Astro.url.pathname, schema } = Astro.props;
const canonicalUrl = new URL(canonicalPath, 'https://viewmbox.com').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 antialiased selection:bg-blue-100 selection:text-blue-900">
    <div id="site-wrapper" class="min-h-screen flex flex-col">
      <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/95 backdrop-blur-md shadow-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
          <div class="flex items-center gap-3 sm:gap-4">
            <a href="/" class="flex items-center gap-2.5 text-lg sm:text-xl font-extrabold tracking-tight text-slate-900 hover:opacity-90 transition">
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-tr from-blue-700 to-indigo-500 text-white shadow-sm ring-1 ring-blue-700/20">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </span>
              <span>ViewMBOX<span class="text-blue-600">.com</span></span>
            </a>
            <span class="hidden lg:inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-800 ring-1 ring-emerald-600/20">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              100% Client-Side &bull; Zero Uploads
            </span>
          </div>

          <!-- Desktop Navigation Links -->
          <nav class="hidden md:flex items-center gap-1 sm:gap-2 text-sm font-medium text-slate-600">
            <a href="/how-to-open-google-takeout-mbox-files/" class="rounded-lg px-3 py-1.5 hover:text-slate-900 hover:bg-slate-100 transition">Takeout Guide</a>
            <a href="/mbox-vs-eml/" class="rounded-lg px-3 py-1.5 hover:text-slate-900 hover:bg-slate-100 transition">MBOX vs EML</a>
            <a href="/how-to-extract-attachments-from-mbox/" class="rounded-lg px-3 py-1.5 hover:text-slate-900 hover:bg-slate-100 transition">Extract Attachments</a>
            <a href="/about/" class="rounded-lg px-3 py-1.5 hover:text-slate-900 hover:bg-slate-100 transition">About</a>
          </nav>

          <!-- Mobile Hamburger Toggle Button -->
          <div class="flex items-center md:hidden">
            <button
              id="mobile-menu-btn"
              type="button"
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 hover:text-slate-900 transition cursor-pointer"
              aria-label="Toggle Navigation"
              aria-expanded="false"
            >
              <svg id="hamburger-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg id="close-icon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Drawer Menu -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200/80 bg-white/98 backdrop-blur-md px-4 py-3 space-y-1 shadow-lg">
          <a href="/how-to-open-google-takeout-mbox-files/" class="flex items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition">
            <svg class="h-4 w-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
            <span>Takeout Guide</span>
          </a>
          <a href="/mbox-vs-eml/" class="flex items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition">
            <svg class="h-4 w-4 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
            <span>MBOX vs EML</span>
          </a>
          <a href="/how-to-extract-attachments-from-mbox/" class="flex items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition">
            <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
            <span>Extract Attachments</span>
          </a>
          <a href="/about/" class="flex items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition">
            <svg class="h-4 w-4 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>About</span>
          </a>
          <div class="pt-2 border-t border-slate-100 flex items-center justify-between px-3 text-xs text-slate-500">
            <span class="inline-flex items-center gap-1.5 font-medium text-emerald-700">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              100% In-Browser Privacy
            </span>
            <span>Zero Server Uploads</span>
          </div>
        </div>
      </header>

      <div class="flex-1">
        <slot />
      </div>

      <footer class="border-t border-slate-200 bg-slate-900 text-slate-400 mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <div class="md:col-span-1 space-y-3">
              <div class="flex items-center gap-2 text-white font-bold text-lg">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-600 text-white">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </span>
                <span>ViewMBOX<span class="text-blue-400">.com</span></span>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed">
                The free, privacy-first in-browser reader for multi-gigabyte MBOX archives and Google Takeout exports.
              </p>
              <div class="inline-flex items-center gap-2 rounded-md bg-slate-800/80 px-2.5 py-1.5 text-xs text-emerald-400 ring-1 ring-emerald-500/20">
                <svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span>Zero files uploaded. 100% offline-ready.</span>
              </div>
            </div>

            <div class="space-y-3">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">User Guides</h3>
              <ul class="space-y-2 text-xs">
                <li><a href="/how-to-open-google-takeout-mbox-files/" class="hover:text-white transition">Open Google Takeout Files</a></li>
                <li><a href="/how-to-open-mbox-in-windows-without-thunderbird/" class="hover:text-white transition">Open MBOX on Windows (No Thunderbird)</a></li>
                <li><a href="/mbox-vs-eml/" class="hover:text-white transition">MBOX vs EML File Differences</a></li>
                <li><a href="/how-to-extract-attachments-from-mbox/" class="hover:text-white transition">Extract Attachments from MBOX</a></li>
              </ul>
            </div>

            <div class="space-y-3">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">Supported Formats</h3>
              <ul class="space-y-2 text-xs">
                <li><span class="text-slate-300">Google Takeout (Gmail)</span></li>
                <li><span class="text-slate-300">Mozilla Thunderbird</span></li>
                <li><span class="text-slate-300">Apple Mail (.mbox exports)</span></li>
                <li><span class="text-slate-300">Eudora &amp; Opera Mail</span></li>
                <li><span class="text-slate-300">RFC 4155 / RFC 822 Archives</span></li>
              </ul>
            </div>

            <div class="space-y-3">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200">Trust &amp; Legal</h3>
              <ul class="space-y-2 text-xs">
                <li><a href="/privacy-policy/" class="hover:text-white transition">Privacy Guarantee &amp; Policy</a></li>
                <li><a href="/about/" class="hover:text-white transition">About &amp; Security Architecture</a></li>
                <li><a href="/sitemap-index.xml" class="hover:text-white transition">XML Sitemap</a></li>
                <li><span class="text-slate-400">Strict Content Security Policy (CSP)</span></li>
              </ul>
            </div>
          </div>

          <div class="mt-10 pt-6 border-t border-slate-800 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-400">
            <p>&copy; {new Date().getFullYear()} ViewMBOX.com &mdash; 100% In-Browser MBOX Reader. All rights reserved.</p>
            <p class="text-slate-400">Built for speed, security, and multi-gigabyte client-side performance.</p>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const hamburger = document.getElementById('hamburger-icon');
      const close = document.getElementById('close-icon');

      if (btn && menu && hamburger && close) {
        btn.addEventListener('click', () => {
          const isOpen = !menu.classList.contains('hidden');
          if (isOpen) {
            menu.classList.add('hidden');
            hamburger.classList.remove('hidden');
            close.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
          } else {
            menu.classList.remove('hidden');
            hamburger.classList.add('hidden');
            close.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
          }
        });

        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            menu.classList.add('hidden');
            hamburger.classList.remove('hidden');
            close.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
          });
        });
      }
    </script>
  </body>
</html>
