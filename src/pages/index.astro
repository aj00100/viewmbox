---
import BaseLayout from '../layouts/BaseLayout.astro';
import MboxApp from '../components/MboxApp.astro';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'ViewMBOX',
      url: 'https://viewmbox.com/',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any (Web Browser)',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description:
        'Free 100% client-side MBOX viewer for 10GB+ Google Takeout, Thunderbird, and Apple Mail archives. Zero uploads, offline-safe.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Can I open a 10GB Google Takeout MBOX file in my browser?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. ViewMBOX is built with an in-browser streaming engine that opens multi-gigabyte archives smoothly with zero uploads and zero memory strain.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are my emails uploaded to a server?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Zero bytes leave your device. You can disconnect your Wi-Fi before dropping an MBOX file to verify it runs 100% offline.',
          },
        },
        {
          '@type': 'Question',
          name: 'How do I open an MBOX file from Google Takeout?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Unzip the downloaded takeout-*.zip archive on your device first. Navigate to Takeout/Mail/All mail.mbox and select or drop that file into ViewMBOX.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I extract attachments and convert emails to PDF?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. You can extract individual file attachments with one click or export emails as standard A4 PDF documents and raw .eml files.',
          },
        },
      ],
    },
  ],
};
---
<BaseLayout
  title="ViewMBOX — Free Online MBOX Viewer for 10GB+ Google Takeout Files"
  description="Open and search 10GB+ Google Takeout, Thunderbird, and Apple Mail .mbox files directly in your browser. 100% local, offline-safe, zero file uploads."
  canonicalPath="/"
  schema={schema}
>
  <!-- Hero Section with floating particles + mesh gradient -->
  <section class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-4 text-center overflow-hidden hero-mesh">
    <!-- Floating dot decorations -->
    <div class="floating-dot bg-blue-400/30 h-3 w-3" style="left: 10%; bottom: 20%; animation-duration: 6s;"></div>
    <div class="floating-dot bg-indigo-400/25 h-2 w-2" style="left: 25%; bottom: 10%; animation-duration: 8s; animation-delay: 1s;"></div>
    <div class="floating-dot bg-blue-500/20 h-4 w-4" style="right: 15%; bottom: 30%; animation-duration: 7s; animation-delay: 2s;"></div>
    <div class="floating-dot bg-violet-400/20 h-2.5 w-2.5" style="right: 30%; bottom: 15%; animation-duration: 9s; animation-delay: 3s;"></div>
    <div class="floating-dot bg-cyan-400/25 h-2 w-2" style="left: 50%; bottom: 5%; animation-duration: 5s; animation-delay: 0.5s;"></div>

    <!-- Truthful trust signal -->
    <div class="inline-flex items-center gap-2 rounded-full bg-white border border-slate-200/90 px-3 py-1 sm:px-4 text-xs text-slate-700 shadow-sm mb-5">
      <svg class="h-4 w-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <span class="font-semibold text-slate-700">100% In-Browser Engine &bull; Zero Server Uploads</span>
    </div>

    <!-- H1 Headline with animated gradient -->
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 max-w-4xl mx-auto leading-tight">
      Free Online MBOX Viewer <br class="hidden sm:inline" />
      <span class="gradient-text-animated">
        for 10GB+ Google Takeout Files
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
      Open, search, and export multi-gigabyte Google Takeout, Mozilla Thunderbird, and Apple Mail archives directly in your browser. Zero software to install, zero file uploads, 100% offline-safe.
    </p>

    <!-- Key Feature Badges -->
    <div class="mt-5 flex flex-wrap justify-center items-center gap-3 sm:gap-6 text-xs font-medium text-slate-700">
      <span class="flex items-center gap-1.5">
        <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
        100% Client-Side Privacy
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
        High-Speed Local Streaming (10GB+ Tested)
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
        Direct PDF &amp; Attachment Export
      </span>
    </div>
  </section>

  <!-- Interactive Application -->
  <MboxApp />

  <!-- Section 1: How It Works (Three Steps) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16 border-t border-slate-200 mt-12">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <p class="text-xs font-extrabold uppercase tracking-wider text-blue-600">Three Simple Steps</p>
      <h2 class="mt-1 text-3xl font-extrabold text-slate-900 tracking-tight">How The Online Viewer Works</h2>
      <p class="mt-2 text-sm text-slate-600">From raw archive file to readable messages in seconds. No cloud upload, no queue.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-7 shadow-sm relative reveal">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 font-black text-blue-600 text-lg mb-5 ring-4 ring-blue-50/50">
          01
        </div>
        <h3 class="text-lg font-bold text-slate-900">Select Your MBOX File</h3>
        <p class="mt-2 text-sm text-slate-600 leading-relaxed">
          Drop your <code>.mbox</code> file into the viewer above, or click Select to browse your local disk. If opening Google Takeout, extract the ZIP first and select <code>All mail.mbox</code>.
        </p>
      </div>

      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-7 shadow-sm relative reveal reveal-delay-1">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 font-black text-indigo-600 text-lg mb-5 ring-4 ring-indigo-50/50">
          02
        </div>
        <h3 class="text-lg font-bold text-slate-900">Instant Local Indexing</h3>
        <p class="mt-2 text-sm text-slate-600 leading-relaxed">
          ViewMBOX scans email boundaries instantly on your device without loading the whole archive into system RAM. Even massive 10GB+ files index smoothly with zero browser lag.
        </p>
      </div>

      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-7 shadow-sm relative reveal reveal-delay-2">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 font-black text-emerald-600 text-lg mb-5 ring-4 ring-emerald-50/50">
          03
        </div>
        <h3 class="text-lg font-bold text-slate-900">Search, Read &amp; Export</h3>
        <p class="mt-2 text-sm text-slate-600 leading-relaxed">
          Filter headers or deep-search message bodies. Preview formatted HTML emails in a sandboxed viewer, extract attachments with one click, or export directly to clean PDF documents.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 2: Privacy Trust Card -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-8 reveal">
    <div class="rounded-3xl border border-emerald-500/30 bg-gradient-to-br from-emerald-500/10 via-emerald-500/5 to-white p-8 sm:p-12 shadow-sm">
      <div class="flex flex-col md:flex-row items-start md:items-center gap-6 mb-8">
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-emerald-600 text-white shadow-lg shadow-emerald-600/20">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <p class="text-xs font-extrabold uppercase tracking-wider text-emerald-800">Privacy First &bull; Zero Server Uploads</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Your Confidential Emails Stay on Your Device</h2>
          <p class="mt-1 text-sm text-slate-600">
            ViewMBOX processes files 100% locally in your browser. We have no way to access your messages, attachments, or contacts.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-emerald-500/20 text-sm">
        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white text-xs font-bold mt-0.5">✓</span>
          <div>
            <strong class="text-slate-900">Zero Server Uploads:</strong>
            <p class="text-xs text-slate-600 mt-0.5">Files never leave your device. All parsing runs client-side via JavaScript Web Workers.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white text-xs font-bold mt-0.5">✓</span>
          <div>
            <strong class="text-slate-900">Nothing Stored Online:</strong>
            <p class="text-xs text-slate-600 mt-0.5">Zero databases, zero logs, zero cloud caching. When you close the tab, memory clears instantly.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white text-xs font-bold mt-0.5">✓</span>
          <div>
            <strong class="text-slate-900">Local Processing:</strong>
            <p class="text-xs text-slate-600 mt-0.5">All parsing and search execution run locally inside your browser session without backend dependencies.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white text-xs font-bold mt-0.5">✓</span>
          <div>
            <strong class="text-slate-900">No Account or Login Required:</strong>
            <p class="text-xs text-slate-600 mt-0.5">No subscription, no email registration, no paywalls. Free and unrestricted for everyone.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Why People Choose ViewMBOX -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <p class="text-xs font-extrabold uppercase tracking-wider text-blue-600">Engineered For Performance</p>
      <h2 class="mt-1 text-3xl font-extrabold text-slate-900 tracking-tight">Why Professionals Choose ViewMBOX</h2>
      <p class="mt-2 text-sm text-slate-600">Designed to handle massive real-world mailbox archives that crash generic tools.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-6 shadow-sm reveal">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 mb-4">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        </div>
        <h3 class="font-bold text-slate-900">Multi-Gigabyte File Support</h3>
        <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
          Unlike generic viewers that crash on large archives, ViewMBOX uses an advanced streaming architecture designed to open 10GB+ files smoothly without freezing your device.
        </p>
      </div>

      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-6 shadow-sm reveal reveal-delay-1">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 mb-4">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </div>
        <h3 class="font-bold text-slate-900">No Desktop Software Required</h3>
        <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
          No need to install bulky desktop email clients like Mozilla Thunderbird or Outlook just to inspect an old archive.
        </p>
      </div>

      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-6 shadow-sm reveal reveal-delay-2">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 mb-4">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
        </div>
        <h3 class="font-bold text-slate-900">Tracking Pixel Protection</h3>
        <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
          Emails render inside a sandboxed iframe with a strict Content Security Policy (CSP). Remote tracking beacons and spy pixels are blocked by default.
        </p>
      </div>

      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-6 shadow-sm reveal">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-600 mb-4">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
        </div>
        <h3 class="font-bold text-slate-900">Attachment Extraction</h3>
        <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
          Extract attached PDF documents, ZIP archives, spreadsheets, invoices, and photos with one click directly into your Downloads folder.
        </p>
      </div>

      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-6 shadow-sm reveal reveal-delay-1">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-50 text-rose-600 mb-4">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
        </div>
        <h3 class="font-bold text-slate-900">Direct PDF &amp; EML Export</h3>
        <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
          Export individual messages as clean, archival-standard PDF documents via in-browser pdf-lib or download raw RFC 822 <code>.eml</code> files.
        </p>
      </div>

      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-6 shadow-sm reveal reveal-delay-2">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-50 text-cyan-600 mb-4">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        </div>
        <h3 class="font-bold text-slate-900">Deep Body &amp; Header Search</h3>
        <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
          Instant keystroke filtering across sender, recipient, and subject lines, plus deep-body text search with Quoted-Printable stream decoding.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 4: Supported Formats & Email Clients -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 border-t border-slate-200">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl font-bold text-slate-900">Supported Email Clients &amp; Archive Formats</h2>
      <p class="mt-2 text-sm text-slate-600">ViewMBOX parses standard RFC 4155 mbox formats generated by all major email providers.</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 text-center">
      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-5 shadow-sm flex flex-col items-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600 mb-2.5">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <strong class="text-xs text-slate-900 block font-bold">Google Takeout</strong>
        <span class="text-[11px] text-slate-500 mt-0.5">All mail.mbox</span>
      </div>

      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-5 shadow-sm flex flex-col items-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-sky-50 text-sky-600 mb-2.5">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <strong class="text-xs text-slate-900 block font-bold">Mozilla Thunderbird</strong>
        <span class="text-[11px] text-slate-500 mt-0.5">Profile / Mail / Local</span>
      </div>

      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-5 shadow-sm flex flex-col items-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-900 mb-2.5">
          <svg class="h-6 w-6 fill-current" viewBox="0 0 814 1000" aria-label="Apple Mail">
            <path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z" />
          </svg>
        </div>
        <strong class="text-xs text-slate-900 block font-bold">Apple Mail</strong>
        <span class="text-[11px] text-slate-500 mt-0.5">Mailbox Exports (.mbox)</span>
      </div>

      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-5 shadow-sm flex flex-col items-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-amber-700 mb-2.5">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <strong class="text-xs text-slate-900 block font-bold">Eudora &amp; Opera</strong>
        <span class="text-[11px] text-slate-500 mt-0.5">Legacy Unix Mailboxes</span>
      </div>

      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-5 shadow-sm flex flex-col items-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-700 mb-2.5">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
          </svg>
        </div>
        <strong class="text-xs text-slate-900 block font-bold">Legal &amp; e-Discovery</strong>
        <span class="text-[11px] text-slate-500 mt-0.5">RFC 4155 Archives</span>
      </div>
    </div>
  </section>

  <!-- Section 5: Frequently Asked Questions -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-16 border-t border-slate-200">
    <div class="text-center mb-12">
      <p class="text-xs font-extrabold uppercase tracking-wider text-blue-600">Got Questions?</p>
      <h2 class="mt-1 text-3xl font-extrabold text-slate-900 tracking-tight">Frequently Asked Questions</h2>
    </div>

    <div class="space-y-4">
      <div class="card-hover rounded-2xl border border-slate-200 bg-white p-6 shadow-sm reveal">
        <h3 class="text-base font-bold text-slate-900">Can I open a 10GB Google Takeout MBOX file in my browser?</h3>
        <p class="mt-2 text-sm text-slate-600 leading-relaxed">
