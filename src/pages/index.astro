---
import BaseLayout from '../layouts/BaseLayout.astro';
import MboxApp from '../components/MboxApp.astro';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'ViewMBOX',
      url: 'https://viewmbox.com/',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any (Web Browser)',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description:
        'Free 100% client-side MBOX viewer for 10GB+ Google Takeout, Thunderbird, and Apple Mail archives. Zero uploads, offline-safe.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Can I open a 10GB Google Takeout MBOX file in my browser?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. ViewMBOX uses 16MB File.slice() chunked streaming inside a Web Worker so multi-gigabyte MBOX archives open with ~20MB RAM and zero uploads.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are my emails uploaded to a server?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Zero bytes leave your device. You can disconnect your Wi-Fi before dropping an MBOX file to verify it runs 100% offline.',
          },
        },
      ],
    },
  ],
};
---
<BaseLayout
  title="ViewMBOX — Free Online MBOX Viewer for 10GB+ Google Takeout Files"
  description="Open and search 10GB+ Google Takeout, Thunderbird, and Apple Mail .mbox files directly in your browser. 100% local, offline-safe, zero file uploads."
  canonicalPath="/"
  schema={schema}
>
  <div class="max-w-7xl mx-auto px-4 pt-8 pb-2">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">
      Free Online MBOX Viewer (10GB+ Local &amp; Offline)
    </h1>
    <p class="mt-2 text-slate-600 max-w-3xl">
      Open Google Takeout, Mozilla Thunderbird, and Apple Mail <code>.mbox</code> archives instantly without installing desktop software or uploading private emails to a cloud server.
    </p>
  </div>

  <MboxApp />

  <section class="max-w-4xl mx-auto px-4 py-10 space-y-6 text-slate-700 leading-relaxed">
    <h2 class="text-2xl font-bold text-slate-900">How ViewMBOX Handles Multi-Gigabyte Archives</h2>
    <p>
      Standard web viewers crash above 50MB because they call <code>file.arrayBuffer()</code> and load the entire archive into browser RAM. ViewMBOX streams your file in 16MB slices inside a background Web Worker, indexing RFC 4155 message boundaries while keeping memory usage flat.
    </p>

    <h2 class="text-2xl font-bold text-slate-900">Built-In Privacy &amp; Tracker Blocking</h2>
    <ul class="list-disc pl-6 space-y-2">
      <li><strong>Zero Server Uploads:</strong> All parsing runs locally. Disconnect Wi-Fi after loading the page to verify.</li>
      <li><strong>Tracking Pixel Protection:</strong> HTML emails render inside a sandboxed iframe with a strict Content Security Policy that blocks remote images and beacons by default.</li>
      <li><strong>Instant Export:</strong> Download individual messages as standard <code>.eml</code> files, save attachments, or print directly to PDF.</li>
    </ul>
  </section>
</BaseLayout>
