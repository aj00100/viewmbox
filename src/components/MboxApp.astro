---
// src/components/MboxApp.astro
---
<section id="mbox-app" class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
  <!-- Privacy & Trust Hero Badge -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-emerald-500/20 bg-gradient-to-r from-emerald-500/10 via-emerald-500/5 to-transparent px-5 py-3.5 text-sm text-emerald-950 shadow-sm backdrop-blur-sm">
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-700 ring-1 ring-emerald-500/20">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </span>
      <div>
        <span class="font-bold">100% In-Browser Privacy:</span>
        <span class="text-emerald-800">Your archive is parsed locally on your device. Zero server uploads, zero external trackers.</span>
      </div>
    </div>
    <span class="hidden sm:inline-flex shrink-0 items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800 ring-1 ring-emerald-500/20">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      Offline-Safe
    </span>
  </div>

  <!-- On-Screen Error Banner -->
  <div id="status-debug" class="mb-4 hidden rounded-xl border border-red-300 bg-red-50 p-4 text-xs font-mono text-red-900 break-words shadow-sm"></div>

  <!-- 1. Dropzone Empty — animated border + glow + full-area drag/drop -->
  <div id="dropzone-empty" class="animated-border dropzone-glow relative rounded-3xl bg-gradient-to-b from-white via-slate-50/50 to-slate-100/30 p-8 sm:p-12 text-center shadow-sm transition-all duration-300 hover:shadow-lg">
    <label for="file-input" id="dropzone" class="block cursor-pointer">
      <input id="file-input" type="file" accept=".mbox,.mbx,.eml,.txt,.zip,.gz,.tgz,*/*" class="sr-only" />

      <!-- Icon Badge with hover pulse -->
      <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-blue-50 text-blue-600 ring-8 ring-blue-50/50 mb-5 pointer-events-none transition-transform duration-300 group-hover:scale-105">
        <svg class="h-10 w-10 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
      </div>

      <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight pointer-events-none">
        Drop your .mbox file here, or click to browse
      </h2>
      <p class="mt-2 text-sm text-slate-500 max-w-lg mx-auto pointer-events-none">
        Supports multi-gigabyte Google Takeout archives, Mozilla Thunderbird folders, Apple Mail, and standard RFC 4155 files.
      </p>

      <!-- Primary Action Button -->
      <div class="mt-6 flex justify-center pointer-events-none">
        <span class="inline-flex items-center gap-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-7 py-3.5 text-sm font-bold text-white shadow-lg shadow-blue-500/25 transition-all duration-200">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          <span>Select MBOX Archive</span>
        </span>
      </div>

      <!-- Feature Pill Badges -->
      <div class="mt-6 flex flex-wrap justify-center items-center gap-2 text-xs font-medium text-slate-600 pointer-events-none">
        <span class="inline-flex items-center gap-1.5 rounded-lg bg-white px-2.5 py-1.5 shadow-sm border border-slate-200/80">
          📁 .mbox / .mbx
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-lg bg-white px-2.5 py-1.5 shadow-sm border border-slate-200/80">
          📦 Google Takeout (All Mail)
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-lg bg-white px-2.5 py-1.5 shadow-sm border border-slate-200/80">
          ⚡ 10GB+ Tested
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-lg bg-white px-2.5 py-1.5 shadow-sm border border-slate-200/80">
          🔒 100% Offline-Safe
        </span>
      </div>
    </label>
  </div>

  <!-- Drag-over visual overlay -->
  <div id="drag-overlay" class="hidden fixed inset-0 z-50 bg-blue-600/10 backdrop-blur-sm flex items-center justify-center pointer-events-none">
    <div class="rounded-3xl border-4 border-dashed border-blue-500 bg-white/90 px-16 py-12 text-center shadow-2xl">
      <svg class="mx-auto h-16 w-16 text-blue-600 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
      </svg>
      <p class="text-xl font-extrabold text-slate-900">Drop to open archive</p>
      <p class="text-sm text-slate-500 mt-1">.mbox, .mbx, .eml supported</p>
    </div>
  </div>

  <!-- 2. Active Archive Loaded Card -->
  <div id="dropzone-active" class="hidden rounded-3xl border border-blue-200/80 bg-gradient-to-r from-blue-50/90 via-indigo-50/50 to-white p-5 sm:p-6 shadow-sm transition-all duration-300">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3.5 min-w-0">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white shadow-md shadow-blue-500/20">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-2.5 py-0.5 text-[11px] font-bold text-emerald-800 ring-1 ring-emerald-500/20">
              <span class="relative flex h-1.5 w-1.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
              </span>
              Active Archive Loaded
            </span>
            <span id="active-file-stat" class="text-xs font-semibold text-slate-500"></span>
            <span id="active-file-timing" class="hidden inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-mono font-bold text-blue-700 ring-1 ring-blue-500/20 shadow-xs"></span>
          </div>
          <h3 id="active-file-name" class="text-base sm:text-lg font-extrabold text-slate-900 truncate mt-0.5" title=""></h3>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button
          id="btn-upload-another"
          type="button"
          class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 shadow-sm hover:bg-slate-50 hover:text-slate-900 active:scale-95 transition-all duration-200 cursor-pointer"
        >
          <svg class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          <span>Upload Another File</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Subtle Status Line -->
  <div id="event-log" class="mt-3 flex items-center justify-between text-[11px] text-slate-400 px-2">
    <div class="flex items-center gap-1.5">
      <span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span>
      <span id="event-status-text">Engine ready. Select an archive to begin.</span>
    </div>
    <span class="font-medium text-slate-300">ViewMBOX v2.0</span>
  </div>

  <!-- ZIP / GZIP Warning Banner -->
  <div id="zip-warning" class="mt-5 hidden rounded-3xl border border-amber-300 bg-amber-50/90 p-6 sm:p-7 text-amber-950 shadow-sm">
    <div class="flex items-center gap-3 font-extrabold text-base sm:text-lg text-amber-900 mb-2">
      <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-amber-200/80 text-amber-800 shrink-0">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </span>
      <span>Google Takeout Archive Detected (.zip / .tgz)</span>
    </div>
    <p class="text-xs sm:text-sm text-amber-900 leading-relaxed max-w-3xl">
      You selected a compressed archive. Web browsers cannot random-seek multi-gigabyte compressed ZIP archives without exhausting device memory. Follow these 3 steps:
    </p>
    <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-3.5">
      <div class="rounded-xl border border-amber-200 bg-white/95 p-4 shadow-sm">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-amber-100 font-black text-amber-800 text-[11px]">01</span>
          <strong class="text-xs text-slate-900">Locate Takeout ZIP</strong>
        </div>
        <p class="text-[11px] text-slate-600 leading-relaxed">
          Find your downloaded <code>takeout-*.zip</code> file in your Downloads folder.
        </p>
      </div>
      <div class="rounded-xl border border-amber-200 bg-white/95 p-4 shadow-sm">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-amber-100 font-black text-amber-800 text-[11px]">02</span>
          <strong class="text-xs text-slate-900">Extract on Device</strong>
        </div>
        <p class="text-[11px] text-slate-600 leading-relaxed">
          Right-click &rarr; <em>Extract All</em> on your computer (or tap Extract on mobile).
        </p>
      </div>
      <div class="rounded-xl border border-amber-200 bg-white/95 p-4 shadow-sm">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-amber-100 font-black text-amber-800 text-[11px]">03</span>
          <strong class="text-xs text-slate-900">Select All mail.mbox</strong>
        </div>
        <p class="text-[11px] text-slate-600 leading-relaxed">
          Open the extracted <code>Takeout/Mail/</code> folder and drop the <code>.mbox</code> file above.
        </p>
      </div>
    </div>
  </div>

  <!-- Scan / Index Progress Bar with Real-Time Timing & Throughput -->
  <div id="progress-wrap" class="mt-5 hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-700 mb-2.5 font-medium">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
        </span>
        <span id="progress-label" class="font-bold text-slate-900">Scanning email boundaries...</span>
      </div>
      <div class="flex items-center gap-2">
        <span id="index-timer-stat" class="font-mono bg-blue-600 text-white px-2.5 py-0.5 rounded-full text-xs font-bold shadow-sm">0.0s</span>
        <span id="progress-pct" class="font-bold text-blue-600">0%</span>
      </div>
    </div>
    <div class="h-3 w-full rounded-full bg-slate-100 overflow-hidden">
      <div id="progress-bar" class="h-full progress-shimmer progress-glow rounded-full transition-all duration-150" style="width:0%"></div>
    </div>
    <div class="mt-2.5 flex items-center justify-between text-[11px] text-slate-500 font-medium">
      <span id="progress-details">0 MB processed</span>
      <span id="index-speed-stat" class="font-mono font-bold text-blue-700">0 MB/s</span>
    </div>
  </div>

  <!-- Deep Search Progress Bar & Real-Time Performance Counter -->
  <div id="search-progress-wrap" class="mt-4 hidden rounded-2xl border border-blue-200 bg-gradient-to-r from-blue-50/95 via-indigo-50/60 to-white p-4 sm:p-5 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-blue-900 mb-2.5">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-blue-600"></span>
        </span>
        <span id="search-progress-label" class="font-extrabold text-sm text-slate-900">Searching email bodies...</span>
      </div>
      <div class="flex items-center gap-2">
        <span id="search-timer-stat" class="font-mono bg-blue-600 text-white px-2.5 py-0.5 rounded-full text-xs font-bold shadow-sm">0.0s</span>
        <button id="btn-cancel-search" class="inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:text-red-600 hover:border-red-300 transition-colors cursor-pointer shadow-sm">
          Cancel <kbd class="kbd">Esc</kbd>
        </button>
      </div>
    </div>
    <div class="h-3 w-full rounded-full bg-blue-100 overflow-hidden">
      <div id="search-progress-bar" class="h-full bg-gradient-to-r from-blue-600 to-indigo-600 rounded-full transition-all duration-100" style="width:0%"></div>
    </div>
    <div id="search-progress-details" class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs font-medium text-slate-600">
      <div class="flex items-center gap-3">
        <span id="search-emails-stat" class="font-mono font-bold text-slate-900">Checked 0 / 0</span>
        <span class="text-slate-300">&bull;</span>
        <span id="search-bytes-stat" class="font-mono text-slate-500">0 MB / 0 MB</span>
      </div>
      <div class="flex items-center gap-3">
        <span id="search-speed-stat" class="font-mono font-bold text-blue-700">0 MB/s</span>
        <span id="search-matches-stat" class="rounded-full bg-emerald-600 text-white font-bold px-2.5 py-0.5 text-[11px] shadow-sm">0 matches</span>
      </div>
    </div>
  </div>

  <!-- Viewer Split Pane — BUG FIX: no conflicting hidden+grid, use wrapper -->
  <div id="viewer-wrapper" class="mt-8 hidden">
    <div id="viewer" class="grid grid-cols-1 gap-5 lg:grid-cols-12">
      <!-- Left Sidebar: Email List & Search -->
      <aside id="email-list-pane" class="lg:col-span-4 flex flex-col border border-slate-200 rounded-2xl bg-white h-[78vh] shadow-sm overflow-hidden scroll-mt-20">
        <div class="p-3.5 border-b border-slate-200 bg-slate-50/80 space-y-2.5">
          <form id="search-form" class="relative" action="javascript:void(0);">
            <input
              id="search-input"
              type="search"
              enterkeyhint="search"
              placeholder="Search subject, sender, body..."
              class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs pr-24 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-none transition-all duration-200"
            />
            <div class="absolute right-1.5 top-1.5 flex items-center gap-1">
              <button
                type="submit"
                id="btn-deep-search"
                title="Search Archive (Enter)"
                class="inline-flex items-center gap-1 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-700 px-2 py-1 text-xs font-bold transition-all duration-150 cursor-pointer active:scale-95"
              >
                <span>🔍</span>
                <span class="text-[10px]">Search</span>
              </button>
            </div>
          </form>

          <!-- Sidebar Live Search Counter -->
          <div id="sidebar-live-counter" class="hidden rounded-xl bg-blue-50 border border-blue-200/90 px-3 py-1.5 text-xs font-mono text-blue-900 flex items-center justify-between shadow-xs">
            <span id="sidebar-count-text" class="font-semibold text-blue-900">Checked 0 / 0</span>
            <span id="sidebar-timer-text" class="font-bold text-white bg-blue-600 px-2 py-0.5 rounded-md text-[11px]">0.0s</span>
          </div>

          <div class="flex items-center justify-between text-xs text-slate-500 font-medium px-1">
            <span id="count-label" class="rounded-full bg-slate-200/80 px-2.5 py-0.5 text-[11px] text-slate-700 font-bold">0 emails</span>
            <div class="flex items-center gap-2">
              <span id="search-mode-indicator" class="text-[11px] text-slate-400">All emails</span>
              <span class="hidden sm:inline-flex items-center gap-1 text-[10px] text-slate-300">
                <kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd> navigate
              </span>
            </div>
          </div>
        </div>
        <div id="email-list" class="flex-1 overflow-y-auto"></div>
        <!-- Load More button for 300+ emails -->
        <div id="load-more-wrap" class="hidden border-t border-slate-200 p-2.5">
          <button id="btn-load-more" class="w-full rounded-xl bg-slate-50 hover:bg-slate-100 px-4 py-2.5 text-xs font-bold text-slate-700 transition-all duration-200 cursor-pointer active:scale-[0.98]">
            Load more emails...
          </button>
        </div>
      </aside>

      <!-- Right Main: Reading Pane -->
      <main id="email-viewer-pane" class="lg:col-span-8 flex flex-col border border-slate-200 rounded-2xl bg-white h-[78vh] shadow-sm overflow-hidden scroll-mt-20">
        <div id="email-header" class="border-b border-slate-200 p-4 sm:p-5 bg-gradient-to-r from-slate-50 to-white hidden">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="max-w-[65%] space-y-1.5">
              <button id="btn-back-to-list" type="button" class="lg:hidden inline-flex items-center gap-1.5 text-xs text-blue-600 font-semibold mb-1 cursor-pointer hover:underline transition-colors">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                Back to list
              </button>
              <h2 id="view-subject" class="text-lg font-bold text-slate-900 tracking-tight break-words leading-snug"></h2>
              <p id="view-from" class="text-xs font-medium text-slate-600 break-words"></p>
              <p id="view-to" class="text-[11px] text-slate-500 break-words hidden"></p>
              <p id="view-date" class="text-[11px] text-slate-400"></p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <button id="btn-print-pdf" class="inline-flex items-center gap-1.5 rounded-lg bg-gradient-to-r from-blue-600 to-indigo-600 px-3.5 py-2 text-xs font-semibold text-white shadow-md shadow-blue-500/20 hover:shadow-lg hover:shadow-blue-500/30 active:scale-95 transition-all duration-200 cursor-pointer" title="Save full visual PDF with all cards, tables, colors, and images">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
                <span>Save PDF (Visual)</span>
              </button>
              <button id="btn-download-pdf" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-2.5 py-2 text-xs font-medium text-slate-700 shadow-sm hover:bg-slate-50 active:scale-95 transition-all duration-200 cursor-pointer" title="Direct raw text download (plain text only, without HTML cards/tables)">
                <svg class="h-3.5 w-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                <span>Text PDF</span>
              </button>
              <button id="btn-download-eml" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 shadow-sm hover:bg-slate-50 active:scale-95 transition-all duration-200 cursor-pointer">
                <svg class="h-3.5 w-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                <span>Save .EML</span>
              </button>
              <button id="btn-remote-img" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-2 text-xs font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all duration-200 cursor-pointer">
                <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                <span>Load Images</span>
              </button>
            </div>
          </div>
          <div id="attachments-bar" class="mt-3.5 flex flex-wrap gap-2"></div>
        </div>
        <div id="email-loading" class="hidden flex-1 flex items-center justify-center text-sm text-slate-400">
          <div class="flex items-center gap-2.5">
            <svg class="animate-spin h-5 w-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            <span>Parsing message MIME stream...</span>
          </div>
        </div>
        <iframe id="email-frame" sandbox="allow-modals" class="flex-1 w-full bg-white border-0"></iframe>
      </main>
    </div>
  </div>

  <!-- Ethical Disclosure -->
  <div class="mt-8 pt-4 border-t border-slate-200 text-center text-[11px] text-slate-400">
    ViewMBOX is 100% tracker-free and does not serve behavioral ad network scripts on private email views.
  </div>
</section>

<script>
  import type { EmailIndexItem, AttachmentMeta } from '../workers/mbox-worker';
  import MboxWorker from '../workers/mbox-worker.ts?worker&inline';

  const debugEl = document.getElementById('status-debug')!;
  const eventStatusText = document.getElementById('event-status-text')!;

  function logStatus(msg: string) {
    const time = new Date().toLocaleTimeString();
    eventStatusText.textContent = `[${time}] ${msg}`;
    console.log('[ViewMBOX]', msg);
  }

  function showError(msg: string) {
    if (!msg) {
      debugEl.classList.add('hidden');
      debugEl.textContent = '';
      return;
    }
    debugEl.textContent = '⚠️ ' + msg;
    debugEl.classList.remove('hidden');
    logStatus('ERROR: ' + msg);
    console.error('[ViewMBOX]', msg);
  }

  window.addEventListener('error', (e) => {
    showError(`Script error: ${e.message} (${e.filename}:${e.lineno})`);
  });
  window.addEventListener('unhandledrejection', (e) => {
    showError(`Unhandled promise rejection: ${e.reason?.message || e.reason}`);
  });

  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const dropzoneEmpty = document.getElementById('dropzone-empty')!;
  const dropzoneActive = document.getElementById('dropzone-active')!;
  const activeFileName = document.getElementById('active-file-name')!;
  const activeFileStat = document.getElementById('active-file-stat')!;
  const activeFileTiming = document.getElementById('active-file-timing')!;
  const btnUploadAnother = document.getElementById('btn-upload-another')!;
  const zipWarning = document.getElementById('zip-warning')!;
  const progressWrap = document.getElementById('progress-wrap')!;
  const progressBar = document.getElementById('progress-bar')!;
  const progressLabel = document.getElementById('progress-label')!;
  const progressPct = document.getElementById('progress-pct')!;
  const progressDetails = document.getElementById('progress-details')!;
  const indexTimerStat = document.getElementById('index-timer-stat')!;
  const indexSpeedStat = document.getElementById('index-speed-stat')!;
  const dragOverlay = document.getElementById('drag-overlay')!;

  const searchProgressWrap = document.getElementById('search-progress-wrap')!;
  const searchProgressBar = document.getElementById('search-progress-bar')!;
  const searchProgressLabel = document.getElementById('search-progress-label')!;
  const searchBytesStat = document.getElementById('search-bytes-stat')!;
  const searchMatchesStat = document.getElementById('search-matches-stat')!;
  const searchTimerStat = document.getElementById('search-timer-stat')!;
  const searchEmailsStat = document.getElementById('search-emails-stat')!;
  const searchSpeedStat = document.getElementById('search-speed-stat')!;
  const sidebarLiveCounter = document.getElementById('sidebar-live-counter')!;
  const sidebarCountText = document.getElementById('sidebar-count-text')!;
  const sidebarTimerText = document.getElementById('sidebar-timer-text')!;
  const btnCancelSearch = document.getElementById('btn-cancel-search')!;

  const viewerWrapper = document.getElementById('viewer-wrapper')!;
  const emailList = document.getElementById('email-list')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const btnDeepSearch = document.getElementById('btn-deep-search')!;
  const countLabel = document.getElementById('count-label')!;
  const searchModeIndicator = document.getElementById('search-mode-indicator')!;
  const loadMoreWrap = document.getElementById('load-more-wrap')!;
  const btnLoadMore = document.getElementById('btn-load-more')!;

  const emailHeader = document.getElementById('email-header')!;
  const emailLoading = document.getElementById('email-loading')!;
  const emailFrame = document.getElementById('email-frame') as HTMLIFrameElement;
  const attachmentsBar = document.getElementById('attachments-bar')!;

  let worker: Worker | null = null;
  let currentFile: File | null = null;
  let allEmails: EmailIndexItem[] = [];
  let visibleEmails: EmailIndexItem[] = [];
  let selectedEmail: EmailIndexItem | null = null;
  let currentRenderedEmail: any = null;
  let currentAllowRemoteImages = false;
  let isDeepSearching = false;
  let displayedCount = 0;
  const BATCH_SIZE = 200;
  let indexStartTime = 0;
  let indexTimerInterval: any = null;

  // Avatar colors keyed on first letter
  const AVATAR_COLORS = [
    'bg-blue-500', 'bg-indigo-500', 'bg-violet-500', 'bg-purple-500',
    'bg-fuchsia-500', 'bg-pink-500', 'bg-rose-500', 'bg-red-500',
    'bg-orange-500', 'bg-amber-500', 'bg-yellow-500', 'bg-lime-500',
    'bg-green-500', 'bg-emerald-500', 'bg-teal-500', 'bg-cyan-500',
    'bg-sky-500', 'bg-blue-600', 'bg-indigo-600', 'bg-violet-600',
    'bg-purple-600', 'bg-fuchsia-600', 'bg-pink-600', 'bg-rose-600',
    'bg-orange-600', 'bg-teal-600',
  ];

  function getAvatarColor(name: string): string {
    const code = (name || 'U').charCodeAt(0);
    return AVATAR_COLORS[code % AVATAR_COLORS.length];
  }

  function getInitials(from: string): string {
    const clean = from.replace(/<[^>]*>/g, '').trim();
    const parts = clean.split(/[\s.]+/).filter(Boolean);
    if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
    return (clean[0] || 'U').toUpperCase();
  }

  function escapeHtml(str: string): string {
    return (str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function formatBytes(bytes: number): string {
    if (!bytes || bytes <= 0) return '0 B';
    if (bytes >= 1024 * 1024 * 1024) return (bytes / (1024 * 1024 * 1024)).toFixed(2) + ' GB';
    if (bytes >= 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    if (bytes >= 1024) return Math.round(bytes / 1024) + ' KB';
    return bytes + ' B';
  }

  async function isCompressedArchive(file: File): Promise<boolean> {
    const name = file.name.toLowerCase();
    if (name.endsWith('.zip') || name.endsWith('.gz') || name.endsWith('.tgz')) return true;
    try {
      const head = new Uint8Array(await file.slice(0, 4).arrayBuffer());
      const isZip = head[0] === 0x50 && head[1] === 0x4b && head[2] === 0x03 && head[3] === 0x04;
      const isGzip = head[0] === 0x1f && head[1] === 0x8b;
      return isZip || isGzip;
    } catch {
      return false;
    }
  }

  function renderList(items: EmailIndexItem[]) {
    visibleEmails = items;
    displayedCount = Math.min(BATCH_SIZE, items.length);
    countLabel.textContent = `${items.length.toLocaleString()} emails`;
    countLabel.classList.add('badge-pop');
    setTimeout(() => countLabel.classList.remove('badge-pop'), 300);
    renderSlice(items, 0, displayedCount);
    updateLoadMoreButton();
  }

  function renderSlice(items: EmailIndexItem[], start: number, end: number) {
    if (items.length === 0) {
      const q = searchInput.value.trim();
      if (q) {
        emailList.innerHTML = `
          <div class="p-6 text-center text-slate-500">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-400 mb-3 ring-4 ring-slate-100/50">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <p class="font-bold text-slate-900 text-sm">0 emails found</p>
            <p class="text-xs text-slate-500 mt-1 max-w-xs mx-auto leading-relaxed">
              No emails matching "${escapeHtml(q)}" were found in this archive.
            </p>
          </div>
        `;
      } else {
        emailList.innerHTML = '<div class="p-6 text-center text-xs text-slate-400">No emails found in archive.</div>';
      }
      return;
    }

    const slice = items.slice(start, end);
    const frag = document.createDocumentFragment();

    for (const item of slice) {
      const btn = document.createElement('button');
      btn.className =
        'email-item w-full text-left p-3 hover:bg-blue-50/70 focus:bg-blue-50 transition-colors duration-150 cursor-pointer border-b border-slate-100/80 last:border-0 flex items-center gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/30';
      if (selectedEmail && selectedEmail.id === item.id) {
        btn.classList.add('email-item-active');
      }

      // Avatar circle
      const initials = getInitials(item.from);
      const colorClass = getAvatarColor(item.from);

      btn.innerHTML = `
        <div class="email-avatar ${colorClass} text-white shrink-0">${escapeHtml(initials)}</div>
        <div class="min-w-0 flex-1">
          <div class="truncate text-[13px] font-semibold text-slate-900 leading-snug"></div>
          <div class="truncate text-[11px] text-slate-600 mt-0.5"></div>
          <div class="truncate text-[10px] text-slate-400 mt-0.5"></div>
        </div>
      `;
      const textContainer = btn.querySelector('.min-w-0')!;
      textContainer.children[0].textContent = item.subject || '(No Subject)';
      textContainer.children[1].textContent = item.from || '(Unknown Sender)';
      textContainer.children[2].textContent = item.date || '';
      btn.onclick = () => requestRenderEmail(item, false, true);
      frag.appendChild(btn);
    }

    if (start === 0) {
      emailList.innerHTML = '';
    }
    emailList.appendChild(frag);
  }

  function updateLoadMoreButton() {
    if (displayedCount < visibleEmails.length) {
      loadMoreWrap.classList.remove('hidden');
      const remaining = visibleEmails.length - displayedCount;
      btnLoadMore.textContent = `Load ${Math.min(BATCH_SIZE, remaining).toLocaleString()} more emails (${remaining.toLocaleString()} remaining)`;
    } else {
      loadMoreWrap.classList.add('hidden');
    }
  }

  btnLoadMore.onclick = () => {
    const prevCount = displayedCount;
    displayedCount = Math.min(displayedCount + BATCH_SIZE, visibleEmails.length);
    renderSlice(visibleEmails, prevCount, displayedCount);
    updateLoadMoreButton();
  };

  function requestRenderEmail(item: EmailIndexItem, allowRemoteImages: boolean, shouldScroll: boolean = false) {
    if (!currentFile || !worker) return;
    selectedEmail = item;
    currentAllowRemoteImages = allowRemoteImages;
    emailHeader.classList.add('hidden');
    emailLoading.classList.remove('hidden');

    if (shouldScroll && window.innerWidth < 1024) {
      const pane = document.getElementById('email-viewer-pane');
      if (pane) {
        pane.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    logStatus(`Rendering email #${item.id + 1} (Array ID: ${item.id}): ${item.subject}...`);
    worker.postMessage({
      type: 'RENDER_EMAIL',
      file: currentFile,
      emailId: item.id,
      start: item.start,
      end: item.end,
      allowRemoteImages,
    });
  }

  function handleEmailRendered(msg: any) {
    currentRenderedEmail = msg;
    emailLoading.classList.add('hidden');
    emailHeader.classList.remove('hidden');

    document.getElementById('view-subject')!.textContent = msg.subject;
    document.getElementById('view-from')!.textContent = `From: ${msg.from}`;
    document.getElementById('view-date')!.textContent = msg.date;

    // Show To field if available
    const viewTo = document.getElementById('view-to')!;
    if (msg.to) {
      viewTo.textContent = `To: ${msg.to}`;
      viewTo.classList.remove('hidden');
    } else {
      viewTo.classList.add('hidden');
    }

    attachmentsBar.innerHTML = '';
    for (const att of (msg.attachments as AttachmentMeta[]) || []) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className =
        'rounded-lg bg-slate-50 border border-slate-200 px-2.5 py-1.5 text-xs text-slate-700 hover:bg-slate-100 hover:border-slate-300 cursor-pointer flex items-center gap-1.5 transition-all duration-200 active:scale-95';
      btn.textContent = `📎 ${att.filename} (${formatBytes(att.size)})`;
      btn.onclick = () => downloadAttachment(att.id, att.filename);
      attachmentsBar.appendChild(btn);
    }

    emailFrame.srcdoc = msg.srcdoc;
    logStatus(`Viewing email #${(msg.emailId ?? 0) + 1} (Array ID: ${msg.emailId ?? 0}): ${msg.subject}`);
  }

  function downloadAttachment(attachmentIndex: number, filename: string) {
    if (!currentFile || !selectedEmail || !worker) return;
    logStatus(`Extracting attachment: ${filename}...`);
    worker.postMessage({
      type: 'GET_ATTACHMENT',
      file: currentFile,
      start: selectedEmail.start,
      end: selectedEmail.end,
      attachmentIndex,
    });
  }

  function downloadRawEml() {
    if (!currentFile || !selectedEmail) return;
    const blob = currentFile.slice(selectedEmail.start, selectedEmail.end, 'message/rfc822');
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    const safeName = (selectedEmail.subject || 'email')
      .replace(/[/\\?%*:|"<>]+/g, '_')
      .replace(/\s+/g, '_')
      .slice(0, 60);
    a.href = url;
    a.download = `${safeName}.eml`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    logStatus(`Downloaded EML: ${safeName}.eml`);
  }

  let searchStartTime = 0;
  let searchTimerInterval: any = null;
  let lastReportedMatchesCount = 0;
  let activeSearchId = 0;
  let lastSearchQuery = '';
  let lastSearchTimestamp = 0;

  function triggerDeepSearch() {
    const q = searchInput.value.trim();
    if (!q || !currentFile || !worker || allEmails.length === 0) return;

    // Debounce duplicate invocations within 400ms (e.g. rapid taps or simultaneous submit events)
    const now = performance.now();
    if (q === lastSearchQuery && isDeepSearching && (now - lastSearchTimestamp) < 400) {
      return;
    }
    lastSearchQuery = q;
    lastSearchTimestamp = now;

    // Cancel any in-flight search
    if (isDeepSearching) {
      worker.postMessage({ type: 'ABORT' });
      clearInterval(searchTimerInterval);
    }

    activeSearchId++;
    const thisSearchId = activeSearchId;
    isDeepSearching = true;
    searchStartTime = performance.now();
    lastReportedMatchesCount = 0;

    searchModeIndicator.textContent = 'Searching...';
    countLabel.textContent = 'Searching...';
    searchProgressWrap.classList.remove('hidden');
    searchProgressBar.style.width = '0%';
    searchProgressLabel.textContent = `Searching for "${q}"...`;
    searchTimerStat.textContent = '0.0s';
    searchEmailsStat.textContent = `Checked 0 / ${allEmails.length.toLocaleString()} emails`;
    searchBytesStat.textContent = `0 MB / ${formatBytes(currentFile.size)}`;
    searchSpeedStat.textContent = '0 MB/s';
    searchMatchesStat.textContent = '0 matches';

    sidebarLiveCounter.classList.remove('hidden');
    sidebarCountText.textContent = `0 / ${allEmails.length.toLocaleString()}`;
    sidebarTimerText.textContent = '0.0s';

    // Show searching state in list
    emailList.innerHTML = `
      <div class="p-8 text-center text-xs text-slate-500 flex flex-col items-center justify-center gap-2.5">
        <svg class="animate-spin h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span class="font-medium text-slate-700">Searching archive...</span>
        <span class="text-[11px] text-slate-400">Scanning headers and email bodies</span>
      </div>
    `;

    clearInterval(searchTimerInterval);
    searchTimerInterval = setInterval(() => {
      const elapsed = ((performance.now() - searchStartTime) / 1000).toFixed(1);
      searchTimerStat.textContent = `${elapsed}s`;
      sidebarTimerText.textContent = `${elapsed}s`;
    }, 100);

    logStatus(`Initiated deep body search for "${q}" [session #${thisSearchId}]...`);
    worker.postMessage({
      type: 'DEEP_SEARCH',
      searchSessionId: thisSearchId,
      file: currentFile,
      query: q,
      items: allEmails,
    });
  }

  function cancelDeepSearch() {
    activeSearchId++;
    if (!worker) return;
    worker.postMessage({ type: 'ABORT' });
    isDeepSearching = false;
    clearInterval(searchTimerInterval);
    searchProgressWrap.classList.add('hidden');
    sidebarLiveCounter.classList.add('hidden');
    searchModeIndicator.textContent = 'All emails';
    renderList(allEmails);
    logStatus('Search cancelled.');
  }

  function printEmail() {
    if (!currentRenderedEmail) {
      showError('Please select an email first before printing or saving to PDF.');
      return;
    }

    const subject = currentRenderedEmail.subject || '(No Subject)';
    const from = currentRenderedEmail.from || '(Unknown Sender)';
    const to = currentRenderedEmail.to || '';
    const date = currentRenderedEmail.date || '';
    const bodyHtml =
      currentRenderedEmail.bodyHtml ||
      `<pre style="white-space: pre-wrap; font-family: system-ui, sans-serif;">${escapeHtml(currentRenderedEmail.text || '')}</pre>`;

    // Extract inner body content if the email is a complete HTML document to prevent nested <html>/<body> tags
    let cleanEmailBody = bodyHtml;
    const bodyMatch = cleanEmailBody.match(/<body[^>]*>([\s\S]*)<\/body>/i);
    if (bodyMatch) {
      cleanEmailBody = bodyMatch[1];
    }

    // Hoist any original email head styles into the print document
    let originalStyles = '';
    const styleMatches = bodyHtml.match(/<style[^>]*>[\s\S]*?<\/style>/gi);
    if (styleMatches) {
      originalStyles = styleMatches.join('\n');
    }

    logStatus(`Preparing isolated print view for "${subject}"...`);

    const printHtml = `<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="${currentAllowRemoteImages ? "default-src 'none'; img-src * data: blob:; style-src 'unsafe-inline'; script-src 'unsafe-inline';" : "default-src 'none'; img-src data: blob:; style-src 'unsafe-inline'; script-src 'unsafe-inline';"}">
  <title>${escapeHtml(subject)}</title>
  ${originalStyles}
  <style>
    @page {
      margin: 10mm 12mm;
      size: auto;
    }
    html, body {
      margin: 0;
      padding: 0;
      background: #ffffff !important;
      color: #111827 !important;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.4;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .email-print-wrap {
      padding: 12px 16px;
      max-width: 800px;
      margin: 0 auto;
    }
    .print-header {
      padding-bottom: 8px;
      margin-bottom: 12px;
      border-bottom: 2px solid #e2e8f0;
    }
    .print-subject {
      font-size: 18px;
      font-weight: 700;
      color: #0f172a;
      margin: 0 0 6px 0;
      line-height: 1.25;
    }
    .print-meta {
      font-size: 11px;
      color: #475569;
      margin: 2px 0;
    }
    .print-meta strong {
      color: #1e293b;
    }
    .print-body {
      word-wrap: break-word;
    }
    /* Natural table flow - NEVER force tr or table to break across pages */
    table, tbody, tr, td {
      page-break-inside: auto !important;
      break-inside: auto !important;
      height: auto !important;
    }
    table {
      max-width: 100% !important;
    }
    img {
      max-width: 100% !important;
      height: auto !important;
    }
    @media print {
      .email-print-wrap {
        padding: 0;
        max-width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="email-print-wrap">
    <div class="print-header">
      <h1 class="print-subject">${escapeHtml(subject)}</h1>
      <div class="print-meta"><strong>From:</strong> ${escapeHtml(from)}</div>
      ${to ? `<div class="print-meta"><strong>To:</strong> ${escapeHtml(to)}</div>` : ''}
      ${date ? `<div class="print-meta"><strong>Date:</strong> ${escapeHtml(date)}</div>` : ''}
    </div>
    <div class="print-body">
      ${cleanEmailBody}
    </div>
  </div>
  <script>
    window.addEventListener('load', () => {
      const imgs = Array.from(document.querySelectorAll('img'));
      const pending = imgs.filter(i => !i.complete);
      const doPrint = () => {
        window.focus();
        window.print();
        setTimeout(() => {
          try { window.close(); } catch (e) {}
        }, 1500);
      };
      if (pending.length > 0) {
        let loaded = 0;
        const check = () => { if (++loaded >= pending.length) doPrint(); };
        pending.forEach(i => { i.onload = check; i.onerror = check; });
        setTimeout(doPrint, 1200);
      } else {
        setTimeout(doPrint, 200);
      }
    });
  <\/script>
</body>
</html>`;

    // Try opening isolated window first (zero connection to homepage)
    const printWin = window.open('', '_blank');
    if (printWin) {
      try {
        printWin.document.open();
        printWin.document.write(printHtml);
        printWin.document.close();
        logStatus(`Opened print view for "${subject}".`);
        return;
      } catch (err) {
        console.warn('Direct popup print write failed, falling back to iframe:', err);
      }
    }

    // Fallback: dedicated hidden print iframe (still 100% isolated from homepage)
    printViaIframe(printHtml);
  }

  function printViaIframe(printHtml: string) {
    let frame = document.getElementById('viewmbox-print-frame') as HTMLIFrameElement;
    if (frame) frame.remove();

    frame = document.createElement('iframe');
    frame.id = 'viewmbox-print-frame';
    frame.style.position = 'fixed';
    frame.style.right = '0';
    frame.style.bottom = '0';
    frame.style.width = '0';
    frame.style.height = '0';
    frame.style.border = '0';
    frame.style.visibility = 'hidden';
    document.body.appendChild(frame);

    const fDoc = frame.contentWindow?.document;
    if (!fDoc) return;

    fDoc.open();
    fDoc.write(printHtml);
    fDoc.close();

    setTimeout(() => {
      try {
        frame.contentWindow?.focus();
        frame.contentWindow?.print();
      } catch (e) {
        window.print();
      }
    }, 500);
  }

  // PDF generation delegates to worker (non-blocking) with logo/image extraction
  function downloadEmailPdf() {
    if (!currentRenderedEmail) {
      showError('Please select an email first before downloading PDF.');
      return;
    }
    if (!worker) {
      showError('Worker not available.');
      return;
    }

    logStatus(`Generating PDF for "${currentRenderedEmail.subject}"...`);

    const inlineImages = (currentRenderedEmail.inlineImages || []).slice();

    // 1. Extract any base64 data URIs embedded in bodyHtml
    if (inlineImages.length === 0 && currentRenderedEmail.bodyHtml) {
      const dataUriMatches = currentRenderedEmail.bodyHtml.matchAll(/src=["'](data:(image\/(?:png|jpeg|jpg));base64,([A-Za-z0-9+/=]+))["']/gi);
      let imgIdx = 0;
      for (const m of dataUriMatches) {
        try {
          const mime = m[2];
          const b64 = m[3];
          const byteChars = atob(b64);
          const bytes = new Uint8Array(byteChars.length);
          for (let i = 0; i < byteChars.length; i++) bytes[i] = byteChars.charCodeAt(i);
          if (bytes.length > 200) {
            inlineImages.push({
              name: `logo_${++imgIdx}.${mime.includes('png') ? 'png' : 'jpg'}`,
              mimeType: mime,
              bytes,
            });
          }
        } catch (e) {}
      }
    }

    // 2. Also attempt to capture loaded logo/banner images from the email iframe DOM via canvas
    if (inlineImages.length === 0) {
      try {
        const iframe = document.getElementById('email-frame') as HTMLIFrameElement;
        const iframeDoc = iframe?.contentDocument || iframe?.contentWindow?.document;
        if (iframeDoc) {
          const domImgs = Array.from(iframeDoc.querySelectorAll('img'));
          let captured = 0;
          for (const img of domImgs) {
            if (!img.complete || img.naturalWidth < 40 || img.naturalHeight < 15) continue;
            try {
              const canvas = document.createElement('canvas');
              canvas.width = Math.min(img.naturalWidth, 800);
              canvas.height = Math.round(canvas.width * (img.naturalHeight / img.naturalWidth));
              const ctx = canvas.getContext('2d');
              if (ctx) {
                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                const dataUrl = canvas.toDataURL('image/png');
                const b64 = dataUrl.split(',')[1];
                if (b64) {
                  const byteChars = atob(b64);
                  const bytes = new Uint8Array(byteChars.length);
                  for (let i = 0; i < byteChars.length; i++) bytes[i] = byteChars.charCodeAt(i);
                  inlineImages.push({
                    name: `logo_${++captured}.png`,
                    mimeType: 'image/png',
                    bytes,
                  });
                  if (captured >= 2) break; // capture up to 2 top logos/banners
                }
              }
            } catch (canvasErr) {
              // Cross-origin tainted canvas - gracefully ignored
            }
          }
        }
      } catch (err) {}
    }

    worker.postMessage({
      type: 'GENERATE_PDF',
      subject: currentRenderedEmail.subject,
      from: currentRenderedEmail.from,
      to: currentRenderedEmail.to,
      date: currentRenderedEmail.date,
      text: currentRenderedEmail.text,
      inlineImages,
    });
  }

  async function handleFile(file: File) {
    showError('');
    if (!file) {
      showError('File selection was empty.');
      return;
    }

    logStatus(`File selected: ${file.name} (${formatBytes(file.size)}). Checking format...`);

    try {
      zipWarning.classList.add('hidden');
      if (await isCompressedArchive(file)) {
        zipWarning.classList.remove('hidden');
        logStatus(`Archive detected: ${file.name} is compressed. Please unzip first.`);
        return;
      }

      if (worker) {
        try { worker.terminate(); } catch {}
        worker = null;
      }
      currentFile = file;
      allEmails = [];
      visibleEmails = [];
      selectedEmail = null;
      currentRenderedEmail = null;

      dropzoneEmpty.classList.add('hidden');
      dropzoneActive.classList.remove('hidden');
      activeFileName.textContent = file.name;
      activeFileName.title = file.name;
      activeFileStat.textContent = formatBytes(file.size);
      activeFileTiming.classList.add('hidden');

      progressWrap.classList.remove('hidden');
      viewerWrapper.classList.remove('hidden');
      progressBar.style.width = '0%';
      progressPct.textContent = '0%';
      indexTimerStat.textContent = '0.0s';
      indexSpeedStat.textContent = '0 MB/s';
      progressLabel.textContent = `Scanning ${file.name} (${formatBytes(file.size)})...`;

      indexStartTime = performance.now();
      clearInterval(indexTimerInterval);
      indexTimerInterval = setInterval(() => {
        const elapsed = ((performance.now() - indexStartTime) / 1000).toFixed(1);
        indexTimerStat.textContent = `${elapsed}s`;
      }, 100);

      logStatus(`Starting Web Worker to index ${file.name}...`);

      worker = new MboxWorker();

      worker.onerror = (e) => {
        clearInterval(indexTimerInterval);
        showError(`Worker runtime error: ${e.message || 'Worker thread failed'}`);
        progressWrap.classList.add('hidden');
      };

      worker.onmessage = (e: MessageEvent) => {
        const msg = e.data;
        if (!msg) return;

        if (msg.type === 'PROGRESS') {
          const elapsedSec = Math.max(0.05, (performance.now() - indexStartTime) / 1000);
          const mbScanned = msg.scannedBytes / (1024 * 1024);
          const mbPerSec = (mbScanned / elapsedSec).toFixed(1);

          progressLabel.textContent = `Scanning ${file.name} (${msg.found.toLocaleString()} emails found)...`;
          progressPct.textContent = `${msg.percent}%`;
          progressBar.style.width = `${msg.percent}%`;
          progressDetails.textContent = `${formatBytes(msg.scannedBytes)} of ${formatBytes(msg.totalBytes)}`;
          indexSpeedStat.textContent = `${mbPerSec} MB/s`;
          logStatus(`Scanning: ${msg.found.toLocaleString()} emails found in ${elapsedSec.toFixed(1)}s (${mbPerSec} MB/s)...`);
        } else if (msg.type === 'BATCH') {
          allEmails.push(...msg.items);
          progressLabel.textContent = `Indexing headers (${allEmails.length.toLocaleString()})...`;
          progressPct.textContent = `${msg.percent}%`;
          progressBar.style.width = `${msg.percent}%`;
          if (allEmails.length <= BATCH_SIZE) renderList(allEmails);
        } else if (msg.type === 'DONE') {
          clearInterval(indexTimerInterval);
          const totalDurationSec = Math.max(0.01, (performance.now() - indexStartTime) / 1000);
          const totalMBPerSec = ((file.size / (1024 * 1024)) / totalDurationSec).toFixed(1);
          const timeStr = `${totalDurationSec.toFixed(2)}s`;

          if (Array.isArray(msg.items) && msg.items.length > 0) {
            allEmails = msg.items;
          }
          progressWrap.classList.add('hidden');
          activeFileStat.textContent = `${formatBytes(file.size)} • ${allEmails.length.toLocaleString()} emails indexed`;
          activeFileTiming.textContent = `${timeStr} • ${totalMBPerSec} MB/s`;
          activeFileTiming.classList.remove('hidden');

          searchModeIndicator.textContent = 'All emails';
          renderList(allEmails);
          logStatus(`Indexing complete: ${allEmails.length.toLocaleString()} emails indexed in ${timeStr} (${totalMBPerSec} MB/s).`);
          if (allEmails.length > 0) requestRenderEmail(allEmails[0], false);
        } else if (msg.type === 'EMAIL_RENDERED') {
          handleEmailRendered(msg);
        } else if (msg.type === 'ATTACHMENT_READY') {
          const blob = new Blob([msg.buffer], { type: msg.mimeType });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = msg.filename;
          a.click();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
          logStatus(`Attachment downloaded: ${msg.filename}`);
        } else if (msg.type === 'PDF_READY') {
          const blob = new Blob([msg.buffer], { type: 'application/pdf' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          const cleanName = (msg.subject || 'email')
            .replace(/[/\\?%*:|"<>]+/g, '_')
            .replace(/\s+/g, '_')
            .slice(0, 60);
          a.href = url;
          a.download = `${cleanName}.pdf`;
          a.click();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
          logStatus(`PDF downloaded: ${cleanName}.pdf`);
        } else if (msg.type === 'PDF_ERROR') {
          showError('PDF generation failed: ' + msg.message);
        } else if (msg.type === 'SEARCH_PROGRESS') {
          if (msg.searchSessionId && msg.searchSessionId !== activeSearchId) return;

          const elapsedSec = Math.max(0.05, (performance.now() - searchStartTime) / 1000);
          const mbScanned = msg.scannedBytes / (1024 * 1024);
          const mbPerSec = (mbScanned / elapsedSec).toFixed(1);

          searchProgressBar.style.width = `${msg.percent}%`;
          searchEmailsStat.textContent = `Checked ${msg.current.toLocaleString()} / ${msg.total.toLocaleString()} (${msg.percent}%)`;
          searchBytesStat.textContent = `${formatBytes(msg.scannedBytes)} of ${formatBytes(msg.totalBytes)}`;
          searchSpeedStat.textContent = `${mbPerSec} MB/s`;
          searchMatchesStat.textContent = `${msg.matchedIds.length} match${msg.matchedIds.length === 1 ? '' : 'es'}`;
          sidebarCountText.textContent = `Checked ${msg.current.toLocaleString()}/${msg.total.toLocaleString()} (${msg.matchedIds.length} hits)`;

          // Avoid DOM thrashing: only re-render if new matches appeared!
          if (msg.matchedIds.length !== lastReportedMatchesCount) {
            lastReportedMatchesCount = msg.matchedIds.length;
            const hits = allEmails.filter((m) => msg.matchedIds.includes(m.id));
            renderList(hits);
          }
        } else if (msg.type === 'SEARCH_DONE') {
          if (msg.searchSessionId && msg.searchSessionId !== activeSearchId) return;

          isDeepSearching = false;
          clearInterval(searchTimerInterval);
          const totalElapsed = ((performance.now() - searchStartTime) / 1000).toFixed(2);
          const totalMB = currentFile ? currentFile.size / (1024 * 1024) : 0;
          const avgSpeed = (totalMB / Math.max(0.01, parseFloat(totalElapsed))).toFixed(1);

          searchTimerStat.textContent = `${totalElapsed}s`;
          searchEmailsStat.textContent = `Finished ${allEmails.length.toLocaleString()} emails`;
          searchSpeedStat.textContent = `${avgSpeed} MB/s avg`;
          searchProgressLabel.textContent = `Search Complete (${totalElapsed}s • ${avgSpeed} MB/s)`;
          sidebarLiveCounter.classList.add('hidden');

          const hits = allEmails.filter((m) => msg.matchedIds.includes(m.id));
          renderList(hits);
          searchModeIndicator.textContent = hits.length === 1 ? '1 result' : `${hits.length.toLocaleString()} results`;
          if (hits.length > 0) {
            requestRenderEmail(hits[0], false, false);
          } else {
            selectedEmail = null;
            currentRenderedEmail = null;
            emailHeader.classList.add('hidden');
            emailFrame.srcdoc = `
              <!DOCTYPE html>
              <html>
                <body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; display: flex; align-items: center; justify-content: center; height: 80vh; color: #94a3b8; text-align: center; margin: 0;">
                  <div>
                    <div style="font-size: 14px; font-weight: 600; color: #64748b; margin-bottom: 4px;">No email selected</div>
                    <div style="font-size: 12px; color: #94a3b8;">Select an email from the search results to read its contents.</div>
                  </div>
                </body>
              </html>
            `;
          }
          logStatus(`Search complete: ${hits.length} matching emails found in ${totalElapsed}s (${avgSpeed} MB/s).`);
        } else if (msg.type === 'SEARCH_ABORTED') {
          if (msg.searchSessionId && msg.searchSessionId !== activeSearchId) return;
          isDeepSearching = false;
          clearInterval(searchTimerInterval);
          sidebarLiveCounter.classList.add('hidden');
          searchProgressWrap.classList.add('hidden');
        } else if (msg.type === 'ERROR') {
          showError(msg.message);
          progressWrap.classList.add('hidden');
        }
      };

      worker.postMessage({ type: 'INDEX', file });
      logStatus(`INDEX message posted to worker.`);
    } catch (err: any) {
      showError('Failed to initialize file processing: ' + (err?.message || String(err)));
    }
  }

  btnUploadAnother.onclick = () => {
    fileInput.value = '';
    fileInput.click();
  };

  fileInput.onchange = () => {
    logStatus('File picker selected a file.');
    const f = fileInput.files?.[0];
    if (f) {
      handleFile(f);
    } else {
      logStatus('File picker closed without file selection.');
    }
  };

  // BUG FIX: Full-page drag/drop support (not just the small label)
  let dragCounter = 0;

  document.addEventListener('dragenter', (e) => {
    e.preventDefault();
    dragCounter++;
    if (dragCounter === 1) {
      dragOverlay.classList.remove('hidden');
    }
  });

  document.addEventListener('dragleave', (e) => {
    e.preventDefault();
    dragCounter--;
    if (dragCounter <= 0) {
      dragCounter = 0;
      dragOverlay.classList.add('hidden');
    }
  });

  document.addEventListener('dragover', (e) => {
    e.preventDefault();
  });

  document.addEventListener('drop', (e) => {
    e.preventDefault();
    dragCounter = 0;
    dragOverlay.classList.add('hidden');
    const f = e.dataTransfer?.files?.[0];
    if (f) {
      logStatus('File dropped: ' + f.name);
      handleFile(f);
    }
  });

  // Also keep the dropzone-specific handlers for click-to-browse
  const dropzone = document.getElementById('dropzone')!;
  dropzone.ondragover = (e) => e.preventDefault();
  dropzone.ondrop = (e) => {
    e.preventDefault();
    dragCounter = 0;
    dragOverlay.classList.add('hidden');
    const f = e.dataTransfer?.files?.[0];
    if (f) {
      logStatus('File dropped onto dropzone: ' + f.name);
      handleFile(f);
    }
  };

  dropzoneActive.ondragover = (e) => e.preventDefault();
  dropzoneActive.ondrop = (e) => {
    e.preventDefault();
    dragCounter = 0;
    dragOverlay.classList.add('hidden');
    const f = e.dataTransfer?.files?.[0];
    if (f) {
      logStatus('File dropped onto active dropzone: ' + f.name);
      handleFile(f);
    }
  };

  // Search input handling: keep email list and count intact while typing or pasting.
  // "0 emails" and search results will only appear once the user actually runs the search (Enter / 🔍).
  searchInput.oninput = () => {
    const q = searchInput.value.trim();
    if (!q) {
      if (isDeepSearching) cancelDeepSearch();
      searchModeIndicator.textContent = 'All emails';
      renderList(allEmails);
      return;
    }
    if (!isDeepSearching) {
      searchModeIndicator.textContent = 'Press Enter to search';
    }
  };

  // Escape cancels search
  searchInput.onkeydown = (e) => {
    if (e.key === 'Escape') {
      cancelDeepSearch();
    }
  };

  // Form submission (handles both Enter key and clicking 🔍 Search button cleanly without double-trigger)
  const searchForm = document.getElementById('search-form') as HTMLFormElement;
  if (searchForm) {
    searchForm.onsubmit = (e) => {
      e.preventDefault();
      triggerDeepSearch();
    };
  }

  btnCancelSearch.onclick = () => cancelDeepSearch();

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isDeepSearching) cancelDeepSearch();
  });

  const btnPrintPdf = document.getElementById('btn-print-pdf');
  if (btnPrintPdf) {
    btnPrintPdf.onclick = () => {
      printEmail();
    };
  }

  document.getElementById('btn-remote-img')!.onclick = () => {
    if (selectedEmail) requestRenderEmail(selectedEmail, true, false);
  };
  document.getElementById('btn-download-eml')!.onclick = () => {
    downloadRawEml();
  };
  document.getElementById('btn-download-pdf')!.onclick = () => {
    downloadEmailPdf();
  };

  const btnBackToList = document.getElementById('btn-back-to-list');
  if (btnBackToList) {
    btnBackToList.onclick = () => {
      const listPane = document.getElementById('email-list-pane');
      if (listPane) {
        listPane.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };
  }

  // Keyboard navigation: ↑/↓ to browse emails, j/k vim-style
  document.addEventListener('keydown', (e) => {
    const targetTag = (document.activeElement?.tagName || '').toUpperCase();
    if (targetTag === 'INPUT' || targetTag === 'TEXTAREA' || (document.activeElement as HTMLElement)?.isContentEditable) return;
    if (visibleEmails.length === 0) return;

    let direction = 0;
    if (e.key === 'ArrowDown' || e.key === 'j') direction = 1;
    if (e.key === 'ArrowUp' || e.key === 'k') direction = -1;
    if (direction === 0) return;

    e.preventDefault();
    const currentIdx = selectedEmail
      ? visibleEmails.findIndex((m) => m.id === selectedEmail!.id)
      : -1;
    const nextIdx = Math.max(0, Math.min(visibleEmails.length - 1, currentIdx + direction));
    const nextEmail = visibleEmails[nextIdx];
    if (nextEmail && nextEmail.id !== selectedEmail?.id) {
      requestRenderEmail(nextEmail, false, false);
      // Scroll list item into view
      const listButtons = emailList.querySelectorAll('.email-item');
      if (listButtons[nextIdx]) {
        listButtons[nextIdx].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
      // Re-render list to update highlight
      renderList(visibleEmails);
    }
  });
</script>
