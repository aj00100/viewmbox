---
// src/components/MboxApp.astro
---
<section id="mbox-app" class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
  <!-- Privacy & Trust Hero Badge -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-emerald-500/20 bg-gradient-to-r from-emerald-500/10 via-emerald-500/5 to-transparent px-5 py-3 text-sm text-emerald-950 shadow-xs">
    <div class="flex items-center gap-3">
      <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-emerald-500/20 text-emerald-700">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </span>
      <div>
        <span class="font-bold">100% In-Browser Privacy:</span>
        <span class="text-emerald-800">Your archive is parsed locally on your device. Zero server uploads, zero trackers. Disconnect internet to verify.</span>
      </div>
    </div>
    <span class="rounded-full bg-emerald-100/80 px-3 py-1 text-xs font-semibold text-emerald-800">100% In-Browser Privacy</span>
  </div>

  <!-- On-Screen Error Banner (Only shown if error occurs) -->
  <div id="status-debug" class="mb-4 hidden rounded-xl border border-red-300 bg-red-50 p-4 text-xs font-mono text-red-900 break-words shadow-sm"></div>

  <!-- Polished High-Converting Dropzone Card -->
  <div class="relative rounded-3xl border-2 border-dashed border-slate-300 bg-gradient-to-b from-white via-slate-50/50 to-slate-100/40 p-8 sm:p-12 text-center shadow-xs transition hover:border-blue-500 hover:shadow-md">
    <label for="file-input" id="dropzone" class="block cursor-pointer">
      <input id="file-input" type="file" accept=".mbox,.mbx,.eml,.txt,.zip,.gz,.tgz,*/*" class="sr-only" />
      
      <!-- Icon Badge -->
      <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-blue-50 text-blue-600 ring-8 ring-blue-50/50 mb-5 pointer-events-none">
        <svg class="h-10 w-10 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
      </div>

      <!-- Main Headline -->
      <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight pointer-events-none">
        Drop your .mbox file here, or click to browse
      </h2>
      <p class="mt-2 text-sm text-slate-500 max-w-lg mx-auto pointer-events-none">
        Supports multi-gigabyte Google Takeout archives, Mozilla Thunderbird folders, Apple Mail, and standard RFC 4155 files.
      </p>

      <!-- Primary Action Button -->
      <div class="mt-6 flex justify-center pointer-events-none">
        <span class="inline-flex items-center gap-2.5 rounded-xl bg-blue-600 px-7 py-3.5 text-sm font-bold text-white shadow-lg shadow-blue-500/25 transition">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          <span>Select MBOX Archive</span>
        </span>
      </div>

      <!-- Feature Pill Badges -->
      <div class="mt-6 flex flex-wrap justify-center items-center gap-2 text-xs font-medium text-slate-600 pointer-events-none">
        <span class="inline-flex items-center gap-1.5 rounded-md bg-white px-2.5 py-1 shadow-2xs border border-slate-200">
          📁 .mbox / .mbx
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-md bg-white px-2.5 py-1 shadow-2xs border border-slate-200">
          📦 Google Takeout (All Mail)
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-md bg-white px-2.5 py-1 shadow-2xs border border-slate-200">
          ⚡ 10GB+ Tested
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-md bg-white px-2.5 py-1 shadow-2xs border border-slate-200">
          🔒 100% Offline-Safe
        </span>
      </div>
    </label>
  </div>

  <!-- Subtle Status Line -->
  <div id="event-log" class="mt-3 flex items-center justify-between text-xs text-slate-400 px-2">
    <div class="flex items-center gap-1.5">
      <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
      <span id="event-status-text">Engine ready. Select an archive to begin.</span>
    </div>
    <span>ViewMBOX v2.0 Client-Side</span>
  </div>

  <!-- 3-Step Google Takeout Visual Workflow -->
  <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-2xs">
      <div class="flex items-center gap-3">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-blue-50 font-extrabold text-blue-600 text-sm">01</span>
        <h3 class="font-bold text-slate-900 text-sm">Download Takeout ZIP</h3>
      </div>
      <p class="mt-2 text-xs text-slate-500 leading-relaxed">
        Google delivers your mail archive as a compressed <code>takeout-*.zip</code> file from Google Takeout.
      </p>
    </div>

    <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-2xs">
      <div class="flex items-center gap-3">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-indigo-50 font-extrabold text-indigo-600 text-sm">02</span>
        <h3 class="font-bold text-slate-900 text-sm">Extract on Your Device</h3>
      </div>
      <p class="mt-2 text-xs text-slate-500 leading-relaxed">
        Right-click &rarr; Extract All. Browsers cannot random-seek multi-gigabyte compressed ZIPs without exhausting memory.
      </p>
    </div>

    <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-2xs">
      <div class="flex items-center gap-3">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-emerald-50 font-extrabold text-emerald-600 text-sm">03</span>
        <h3 class="font-bold text-slate-900 text-sm">Drop the .mbox File</h3>
      </div>
      <p class="mt-2 text-xs text-slate-500 leading-relaxed">
        Navigate to <code>Takeout/Mail/All mail.mbox</code> and select it above. Indexing starts immediately.
      </p>
    </div>
  </div>

  <!-- ZIP / GZIP Warning Banner -->
  <div id="zip-warning" class="mt-5 hidden rounded-2xl border border-amber-300 bg-amber-50/80 p-5 text-sm text-amber-950 shadow-xs">
    <div class="flex items-center gap-2 font-bold text-base text-amber-900">
      <svg class="h-5 w-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span>Google Takeout Archive Detected (.zip / .tgz)</span>
    </div>
    <p class="mt-2 text-xs text-amber-800 leading-relaxed">
      You dropped a compressed archive. Modern browsers cannot stream-decompress multi-gigabyte ZIP/TGZ files with random access without exhausting device memory.
    </p>
    <div class="mt-3 rounded-xl bg-amber-100/70 p-3 text-xs font-semibold text-amber-900">
      &rarr; Please unzip the download on your device first, open the <code>Takeout/Mail/</code> folder, and drop the <code>.mbox</code> file here.
    </div>
  </div>

  <!-- Scan / Index Progress Bar -->
  <div id="progress-wrap" class="mt-5 hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
    <div class="flex justify-between text-xs text-slate-700 mb-2 font-medium">
      <span id="progress-label" class="font-bold text-slate-900">Scanning email boundaries...</span>
      <span id="progress-pct" class="font-bold text-blue-600">0%</span>
    </div>
    <div class="h-3 w-full rounded-full bg-slate-100 overflow-hidden">
      <div id="progress-bar" class="h-full bg-gradient-to-r from-blue-600 to-indigo-600 transition-all duration-150" style="width:0%"></div>
    </div>
    <div id="progress-details" class="mt-2 text-xs text-slate-500">0 MB processed</div>
  </div>

  <!-- Deep Search Progress Bar (Tier 2 Progressive Scan) -->
  <div id="search-progress-wrap" class="mt-4 hidden rounded-2xl border border-blue-200 bg-blue-50/80 p-4 shadow-xs">
    <div class="flex items-center justify-between text-xs text-blue-900 mb-2">
      <span id="search-progress-label" class="font-bold">Searching email bodies...</span>
      <button id="btn-cancel-search" class="text-xs font-semibold text-blue-700 hover:text-red-600 underline cursor-pointer">
        Cancel Search (Esc)
      </button>
    </div>
    <div class="h-2.5 w-full rounded-full bg-blue-200 overflow-hidden">
      <div id="search-progress-bar" class="h-full bg-blue-600 transition-all duration-150" style="width:0%"></div>
    </div>
    <div id="search-progress-details" class="mt-2 flex justify-between text-xs text-blue-700 font-medium">
      <span id="search-bytes-stat">0 MB / 0 MB scanned</span>
      <span id="search-matches-stat">0 matches</span>
    </div>
  </div>

  <!-- Viewer Split Pane -->
  <div id="viewer" class="mt-8 hidden grid grid-cols-1 gap-5 lg:grid-cols-12">
    <!-- Left Sidebar: Email List & Search -->
    <aside class="lg:col-span-4 flex flex-col border border-slate-200 rounded-2xl bg-white h-[78vh] shadow-sm overflow-hidden">
      <div class="p-3.5 border-b border-slate-200 bg-slate-50/50 space-y-2.5">
        <div class="relative">
          <input
            id="search-input"
            type="search"
            placeholder="Filter subject, sender... (Press Enter for body search)"
            class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs pr-8 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-none transition"
          />
          <button id="btn-deep-search" title="Deep Search Email Bodies" class="absolute right-2.5 top-2 text-xs text-slate-400 hover:text-blue-600 cursor-pointer">
            🔍
          </button>
        </div>
        <div class="flex items-center justify-between text-xs text-slate-500 font-medium px-1">
          <span id="count-label" class="rounded-full bg-slate-200/80 px-2 py-0.5 text-[11px] text-slate-700 font-bold">0 emails</span>
          <span id="search-mode-indicator" class="text-[11px] text-slate-400">Header filter</span>
        </div>
      </div>
      <div id="email-list" class="flex-1 overflow-y-auto divide-y divide-slate-100"></div>
    </aside>

    <!-- Right Main: Reading Pane -->
    <main class="lg:col-span-8 flex flex-col border border-slate-200 rounded-2xl bg-white h-[78vh] shadow-sm overflow-hidden">
      <div id="email-header" class="border-b border-slate-200 p-4 sm:p-5 bg-slate-50/50 hidden">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="max-w-[65%] space-y-1">
            <h2 id="view-subject" class="text-lg font-bold text-slate-900 tracking-tight break-words"></h2>
            <p id="view-from" class="text-xs font-medium text-slate-600 break-words"></p>
            <p id="view-date" class="text-[11px] text-slate-400"></p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <button id="btn-download-pdf" class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 active:scale-95 transition cursor-pointer">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              <span>Download PDF</span>
            </button>
            <button id="btn-download-eml" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 shadow-2xs hover:bg-slate-50 active:scale-95 transition cursor-pointer">
              <svg class="h-3.5 w-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              <span>Save .EML</span>
            </button>
            <button id="btn-print" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 shadow-2xs hover:bg-slate-50 active:scale-95 transition cursor-pointer">
              <svg class="h-3.5 w-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
              <span>Print</span>
            </button>
            <button id="btn-remote-img" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition cursor-pointer">
              <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              <span>Load Images</span>
            </button>
          </div>
        </div>
        <div id="attachments-bar" class="mt-3.5 flex flex-wrap gap-2"></div>
      </div>
      <div id="email-loading" class="hidden flex-1 flex items-center justify-center text-sm text-slate-400">
        <div class="flex items-center gap-2">
          <svg class="animate-spin h-5 w-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span>Parsing message MIME stream...</span>
        </div>
      </div>
      <iframe id="email-frame" sandbox="allow-modals" class="flex-1 w-full bg-white border-0"></iframe>
    </main>
  </div>

  <!-- Ethical Disclosure -->
  <div class="mt-8 pt-4 border-t border-slate-200 text-center text-xs text-slate-400">
    ViewMBOX is 100% tracker-free and does not serve behavioral ad network scripts on private email views.
  </div>
</section>

<script>
  import type { EmailIndexItem, AttachmentMeta } from '../workers/mbox-worker';

  const debugEl = document.getElementById('status-debug')!;
  const eventStatusText = document.getElementById('event-status-text')!;

  function logStatus(msg: string) {
    const time = new Date().toLocaleTimeString();
    eventStatusText.textContent = `[${time}] ${msg}`;
    console.log('[ViewMBOX]', msg);
  }

  function showError(msg: string) {
    if (!msg) {
      debugEl.classList.add('hidden');
      debugEl.textContent = '';
      return;
    }
    debugEl.textContent = '⚠️ ' + msg;
    debugEl.classList.remove('hidden');
    logStatus('ERROR: ' + msg);
    console.error('[ViewMBOX]', msg);
  }

  window.addEventListener('error', (e) => {
    showError(`Script error: ${e.message} (${e.filename}:${e.lineno})`);
  });
  window.addEventListener('unhandledrejection', (e) => {
    showError(`Unhandled promise rejection: ${e.reason?.message || e.reason}`);
  });

  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const zipWarning = document.getElementById('zip-warning')!;
  const progressWrap = document.getElementById('progress-wrap')!;
  const progressBar = document.getElementById('progress-bar')!;
  const progressLabel = document.getElementById('progress-label')!;
  const progressPct = document.getElementById('progress-pct')!;
  const progressDetails = document.getElementById('progress-details')!;

  const searchProgressWrap = document.getElementById('search-progress-wrap')!;
  const searchProgressBar = document.getElementById('search-progress-bar')!;
  const searchProgressLabel = document.getElementById('search-progress-label')!;
  const searchBytesStat = document.getElementById('search-bytes-stat')!;
  const searchMatchesStat = document.getElementById('search-matches-stat')!;
  const btnCancelSearch = document.getElementById('btn-cancel-search')!;

  const viewer = document.getElementById('viewer')!;
  const emailList = document.getElementById('email-list')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const btnDeepSearch = document.getElementById('btn-deep-search')!;
  const countLabel = document.getElementById('count-label')!;
  const searchModeIndicator = document.getElementById('search-mode-indicator')!;

  const emailHeader = document.getElementById('email-header')!;
  const emailLoading = document.getElementById('email-loading')!;
  const emailFrame = document.getElementById('email-frame') as HTMLIFrameElement;
  const attachmentsBar = document.getElementById('attachments-bar')!;

  let worker: Worker | null = null;
  let currentFile: File | null = null;
  let allEmails: EmailIndexItem[] = [];
  let visibleEmails: EmailIndexItem[] = [];
  let selectedEmail: EmailIndexItem | null = null;
  let currentRenderedEmail: any = null;
  let isDeepSearching = false;

  function escapeHtml(str: string): string {
    return (str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function formatBytes(bytes: number): string {
    if (!bytes || bytes <= 0) return '0 B';
    if (bytes >= 1024 * 1024 * 1024) return (bytes / (1024 * 1024 * 1024)).toFixed(2) + ' GB';
    if (bytes >= 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    if (bytes >= 1024) return Math.round(bytes / 1024) + ' KB';
    return bytes + ' B';
  }

  async function isCompressedArchive(file: File): Promise<boolean> {
    const name = file.name.toLowerCase();
    if (name.endsWith('.zip') || name.endsWith('.gz') || name.endsWith('.tgz')) return true;
    try {
      const head = new Uint8Array(await file.slice(0, 4).arrayBuffer());
      const isZip = head[0] === 0x50 && head[1] === 0x4b && head[2] === 0x03 && head[3] === 0x04;
      const isGzip = head[0] === 0x1f && head[1] === 0x8b;
      return isZip || isGzip;
    } catch {
      return false;
    }
  }

  function renderList(items: EmailIndexItem[]) {
    visibleEmails = items;
    countLabel.textContent = `${items.length.toLocaleString()} emails`;
    const slice = items.slice(0, 300);
    const frag = document.createDocumentFragment();

    for (const item of slice) {
      const btn = document.createElement('button');
      btn.className =
        'w-full text-left p-3 hover:bg-blue-50 focus:bg-blue-50 transition cursor-pointer border-b border-slate-100 last:border-0';
      if (selectedEmail && selectedEmail.id === item.id) {
        btn.classList.add('bg-blue-50', 'border-l-4', 'border-l-blue-600');
      }
      btn.innerHTML = `
        <div class="truncate text-xs font-semibold text-slate-900"></div>
        <div class="truncate text-[11px] text-slate-600 mt-0.5"></div>
        <div class="truncate text-[10px] text-slate-400 mt-0.5"></div>
      `;
      btn.children[0].textContent = item.subject || '(No Subject)';
      btn.children[1].textContent = item.from || '(Unknown Sender)';
      btn.children[2].textContent = item.date || '';
      btn.onclick = () => requestRenderEmail(item, false);
      frag.appendChild(btn);
    }

    emailList.innerHTML = '';
    emailList.appendChild(frag);
  }

  function requestRenderEmail(item: EmailIndexItem, allowRemoteImages: boolean) {
    if (!currentFile || !worker) return;
    selectedEmail = item;
    emailHeader.classList.add('hidden');
    emailLoading.classList.remove('hidden');

    logStatus(`Rendering email #${item.id + 1}: ${item.subject}...`);
    worker.postMessage({
      type: 'RENDER_EMAIL',
      file: currentFile,
      emailId: item.id,
      start: item.start,
      end: item.end,
      allowRemoteImages,
    });
  }

  function handleEmailRendered(msg: any) {
    currentRenderedEmail = msg;
    emailLoading.classList.add('hidden');
    emailHeader.classList.remove('hidden');

    document.getElementById('view-subject')!.textContent = msg.subject;
    document.getElementById('view-from')!.textContent = `From: ${msg.from}`;
    document.getElementById('view-date')!.textContent = msg.date;

    attachmentsBar.innerHTML = '';
    for (const att of (msg.attachments as AttachmentMeta[]) || []) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className =
        'rounded bg-slate-100 px-2 py-1 text-xs text-slate-700 hover:bg-slate-200 cursor-pointer flex items-center gap-1';
      btn.textContent = `📎 ${att.filename} (${formatBytes(att.size)})`;
      btn.onclick = () => downloadAttachment(att.id, att.filename);
      attachmentsBar.appendChild(btn);
    }

    emailFrame.srcdoc = msg.srcdoc;
    logStatus(`Viewing email #${(msg.emailId ?? 0) + 1}: ${msg.subject}`);

    // Pre-populate dedicated print container and activate print media mode
    const printArea = document.getElementById('print-area');
    if (printArea) {
      printArea.innerHTML = `
        <div style="border-bottom: 2px solid #cbd5e1; padding-bottom: 12px; margin-bottom: 20px;">
          <h1 style="font-size: 20px; font-weight: 700; color: #0f172a; margin: 0 0 6px 0;">${escapeHtml(msg.subject)}</h1>
          <div style="font-size: 13px; color: #475569; margin-bottom: 3px;"><strong>From:</strong> ${escapeHtml(msg.from)}</div>
          ${msg.to ? `<div style="font-size: 13px; color: #475569; margin-bottom: 3px;"><strong>To:</strong> ${escapeHtml(msg.to)}</div>` : ''}
          <div style="font-size: 13px; color: #475569;"><strong>Date:</strong> ${escapeHtml(msg.date)}</div>
        </div>
        <div style="font-size: 14px; line-height: 1.6; color: #1e293b;">
          ${msg.bodyHtml}
        </div>
      `;
      document.body.classList.add('has-print-content');
    }
  }

  function downloadAttachment(attachmentIndex: number, filename: string) {
    if (!currentFile || !selectedEmail || !worker) return;
    logStatus(`Extracting attachment: ${filename}...`);
    worker.postMessage({
      type: 'GET_ATTACHMENT',
      file: currentFile,
      start: selectedEmail.start,
      end: selectedEmail.end,
      attachmentIndex,
    });
  }

  function downloadRawEml() {
    if (!currentFile || !selectedEmail) return;
    const blob = currentFile.slice(selectedEmail.start, selectedEmail.end, 'message/rfc822');
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    // Preserve Unicode characters (Japanese, Spanish, accents), strip only illegal file system characters
    const safeName = (selectedEmail.subject || 'email')
      .replace(/[/\\?%*:|"<>]+/g, '_')
      .replace(/\s+/g, '_')
      .slice(0, 60);
    a.href = url;
    a.download = `${safeName}.eml`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    logStatus(`Downloaded EML: ${safeName}.eml`);
  }

  function triggerDeepSearch() {
    const q = searchInput.value.trim();
    if (!q || !currentFile || !worker || allEmails.length === 0) return;

    isDeepSearching = true;
    searchModeIndicator.textContent = 'Deep Body Search';
    searchProgressWrap.classList.remove('hidden');
    searchProgressBar.style.width = '0%';
    searchBytesStat.textContent = `0 MB / ${formatBytes(currentFile.size)} scanned`;
    searchMatchesStat.textContent = '0 matches';

    logStatus(`Initiated deep body search for "${q}"...`);
    worker.postMessage({
      type: 'DEEP_SEARCH',
      file: currentFile,
      query: q,
      items: allEmails,
    });
  }

  function cancelDeepSearch() {
    if (!worker) return;
    worker.postMessage({ type: 'ABORT' });
    isDeepSearching = false;
    searchProgressWrap.classList.add('hidden');
    searchModeIndicator.textContent = 'Header filter';
    logStatus('Deep search cancelled.');
  }

  async function handleFile(file: File) {
    showError('');
    if (!file) {
      showError('File selection was empty.');
      return;
    }

    logStatus(`File selected: ${file.name} (${formatBytes(file.size)}). Checking format...`);

    try {
      zipWarning.classList.add('hidden');
      if (await isCompressedArchive(file)) {
        zipWarning.classList.remove('hidden');
        logStatus(`Archive detected: ${file.name} is compressed. Please unzip first.`);
        return;
      }

      if (worker) {
        try { worker.terminate(); } catch {}
        worker = null;
      }
      currentFile = file;
      allEmails = [];
      visibleEmails = [];
      selectedEmail = null;
      currentRenderedEmail = null;
      document.body.classList.remove('has-print-content');
      const printArea = document.getElementById('print-area');
      if (printArea) printArea.innerHTML = '';

      progressWrap.classList.remove('hidden');
      viewer.classList.remove('hidden');
      progressBar.style.width = '0%';
      progressLabel.textContent = `Scanning ${file.name} (${formatBytes(file.size)})...`;

      logStatus(`Starting Web Worker to index ${file.name}...`);

      worker = new Worker(new URL('../workers/mbox-worker.ts', import.meta.url), {
        type: 'module',
      });

      worker.onerror = (e) => {
        showError(`Worker runtime error: ${e.message || 'Worker thread failed'}`);
        progressWrap.classList.add('hidden');
      };

      worker.onmessage = (e: MessageEvent) => {
        const msg = e.data;
        if (!msg) return;

        if (msg.type === 'PROGRESS') {
          progressLabel.textContent = `Scanning ${file.name} (${msg.found.toLocaleString()} emails found)...`;
          progressPct.textContent = `${msg.percent}%`;
          progressBar.style.width = `${msg.percent}%`;
          progressDetails.textContent = `${formatBytes(msg.scannedBytes)} of ${formatBytes(msg.totalBytes)} indexed`;
          logStatus(`Scanning: ${msg.found.toLocaleString()} emails found (${msg.percent}%)...`);
        } else if (msg.type === 'BATCH') {
          allEmails.push(...msg.items);
          progressLabel.textContent = `Indexing headers (${allEmails.length.toLocaleString()})...`;
          progressPct.textContent = `${msg.percent}%`;
          progressBar.style.width = `${msg.percent}%`;
          if (allEmails.length <= 300) renderList(allEmails);
        } else if (msg.type === 'DONE') {
          progressWrap.classList.add('hidden');
          renderList(allEmails);
          logStatus(`Done! Indexed ${allEmails.length.toLocaleString()} emails.`);
          if (allEmails.length > 0) requestRenderEmail(allEmails[0], false);
        } else if (msg.type === 'EMAIL_RENDERED') {
          handleEmailRendered(msg);
        } else if (msg.type === 'ATTACHMENT_READY') {
          const blob = new Blob([msg.buffer], { type: msg.mimeType });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = msg.filename;
          a.click();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
          logStatus(`Attachment downloaded: ${msg.filename}`);
        } else if (msg.type === 'PDF_READY') {
          const blob = new Blob([msg.buffer], { type: 'application/pdf' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          const cleanName = (msg.subject || 'email')
            .replace(/[/\\?%*:|"<>]+/g, '_')
            .replace(/\s+/g, '_')
            .slice(0, 60);
          a.href = url;
          a.download = `${cleanName}.pdf`;
          a.click();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
          logStatus(`PDF downloaded to Downloads folder: ${cleanName}.pdf`);
        } else if (msg.type === 'PDF_ERROR') {
          showError('PDF generation failed: ' + msg.message);
        } else if (msg.type === 'SEARCH_PROGRESS') {
          searchProgressBar.style.width = `${msg.percent}%`;
          searchBytesStat.textContent = `${formatBytes(msg.scannedBytes)} of ${formatBytes(msg.totalBytes)} scanned (${msg.percent}%)`;
          searchMatchesStat.textContent = `${msg.matchedIds.length} matches`;
          const hits = allEmails.filter((m) => msg.matchedIds.includes(m.id));
          renderList(hits);
        } else if (msg.type === 'SEARCH_DONE') {
          isDeepSearching = false;
          searchProgressWrap.classList.add('hidden');
          const hits = allEmails.filter((m) => msg.matchedIds.includes(m.id));
          renderList(hits);
          logStatus(`Search complete: ${hits.length} matching emails found.`);
        } else if (msg.type === 'SEARCH_ABORTED') {
          isDeepSearching = false;
          searchProgressWrap.classList.add('hidden');
        } else if (msg.type === 'ERROR') {
          showError(msg.message);
          progressWrap.classList.add('hidden');
        }
      };

      worker.postMessage({ type: 'INDEX', file });
      logStatus(`INDEX message posted to worker.`);
    } catch (err: any) {
      showError('Failed to initialize file processing: ' + (err?.message || String(err)));
    }
  }

  // Native File Input change
  fileInput.onchange = () => {
    logStatus('File picker selected a file.');
    const f = fileInput.files?.[0];
    if (f) {
      handleFile(f);
    } else {
      logStatus('File picker closed without file selection.');
    }
  };

  // Drag and Drop (desktop / tablet)
  const dropzone = document.getElementById('dropzone')!;
  dropzone.ondragover = (e) => e.preventDefault();
  dropzone.ondrop = (e) => {
    e.preventDefault();
    const f = e.dataTransfer?.files?.[0];
    if (f) {
      logStatus('File dropped onto dropzone: ' + f.name);
      handleFile(f);
    }
  };

  // Instant Header Filter on keystroke
  searchInput.oninput = () => {
    if (isDeepSearching) cancelDeepSearch();
    const q = searchInput.value.trim().toLowerCase();
    searchModeIndicator.textContent = 'Header filter';
    if (!q) return renderList(allEmails);
    const filtered = allEmails.filter(
      (m) =>
        m.subject.toLowerCase().includes(q) ||
        m.from.toLowerCase().includes(q) ||
        m.date.toLowerCase().includes(q)
    );
    renderList(filtered);
  };

  // Enter triggers Deep Body Search
  searchInput.onkeydown = (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      triggerDeepSearch();
    } else if (e.key === 'Escape') {
      cancelDeepSearch();
    }
  };

  btnDeepSearch.onclick = () => triggerDeepSearch();
  btnCancelSearch.onclick = () => cancelDeepSearch();

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isDeepSearching) cancelDeepSearch();
  });

  function downloadEmailPdf() {
    if (!currentRenderedEmail || !worker) {
      showError('Please select an email first before downloading PDF.');
      return;
    }
    logStatus(`Generating PDF for "${currentRenderedEmail.subject}"...`);
    worker.postMessage({
      type: 'GENERATE_PDF',
      subject: currentRenderedEmail.subject,
      from: currentRenderedEmail.from,
      to: currentRenderedEmail.to,
      date: currentRenderedEmail.date,
      text: currentRenderedEmail.text,
    });
  }

  document.getElementById('btn-remote-img')!.onclick = () => {
    if (selectedEmail) requestRenderEmail(selectedEmail, true);
  };
  document.getElementById('btn-download-eml')!.onclick = () => {
    downloadRawEml();
  };
  document.getElementById('btn-download-pdf')!.onclick = () => {
    downloadEmailPdf();
  };

  // Dedicated print container: 100% immune to iframe cross-origin SecurityErrors and UI leakage
  document.getElementById('btn-print')!.onclick = () => {
    if (!currentRenderedEmail) {
      showError('Please select an email first before printing.');
      return;
    }
    const printArea = document.getElementById('print-area');
    if (printArea) {
      printArea.innerHTML = `
        <div style="border-bottom: 2px solid #cbd5e1; padding-bottom: 12px; margin-bottom: 20px;">
          <h1 style="font-size: 20px; font-weight: 700; color: #0f172a; margin: 0 0 6px 0;">${escapeHtml(currentRenderedEmail.subject)}</h1>
          <div style="font-size: 13px; color: #475569; margin-bottom: 3px;"><strong>From:</strong> ${escapeHtml(currentRenderedEmail.from)}</div>
          ${currentRenderedEmail.to ? `<div style="font-size: 13px; color: #475569; margin-bottom: 3px;"><strong>To:</strong> ${escapeHtml(currentRenderedEmail.to)}</div>` : ''}
          <div style="font-size: 13px; color: #475569;"><strong>Date:</strong> ${escapeHtml(currentRenderedEmail.date)}</div>
        </div>
        <div style="font-size: 14px; line-height: 1.6; color: #1e293b;">
          ${currentRenderedEmail.bodyHtml}
        </div>
      `;
      document.body.classList.add('has-print-content');
    }
    logStatus(`Opening Print preview for: ${currentRenderedEmail.subject}`);
    window.print();
  };
</script>
