---
// src/components/MboxApp.astro
// In-browser 10GB MBOX Streaming Viewer & Takeout Extractor
---

<div class="mbox-app-container max-w-6xl mx-auto px-4 py-8" id="mbox-app-root">
  <!-- ZIP / GZIP Warning Banner (Triggered when user drops a Takeout ZIP) -->
  <div class="hidden mb-6 bg-amber-50 border-2 border-amber-300 rounded-2xl p-6 text-slate-800" id="zip-warning-box">
    <div class="flex items-start gap-4">
      <div class="text-3xl">📦</div>
      <div class="flex-1">
        <h3 class="text-base font-bold text-amber-900 mb-1">Google Takeout ZIP Archive Detected</h3>
        <p class="text-sm text-amber-800 leading-relaxed mb-3">
          Google Takeout exports your emails inside a compressed <code>.zip</code> file. Web browsers cannot stream gigabyte archives directly inside a zip without unzipping them first.
        </p>
        <div class="bg-white/80 border border-amber-200 rounded-lg p-3 text-xs space-y-1 mb-4 font-mono text-slate-700">
          <div>1. Right-click your downloaded ZIP file and click <strong>"Extract All"</strong>.</div>
          <div>2. Open the extracted folder: <code>Takeout / Mail /</code></div>
          <div>3. Drop the <code>All mail.mbox</code> file directly here.</div>
        </div>
        <button type="button" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold text-xs px-4 py-2 rounded-lg cursor-pointer" id="btn-dismiss-zip-warning">
          Got it, dismiss
        </button>
      </div>
    </div>
  </div>

  <!-- 1. Dropzone Screen -->
  <div class="dropzone-section bg-white border-2 border-dashed border-slate-300 hover:border-sky-500 rounded-2xl p-12 text-center transition cursor-pointer" id="mbox-dropzone">
    <input type="file" id="mbox-file-input" accept=".mbox,application/mbox,text/plain" class="hidden" />

    <div class="w-16 h-16 mx-auto mb-4 bg-sky-50 text-sky-600 rounded-2xl flex items-center justify-center">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
      </svg>
    </div>

    <h2 class="text-2xl font-bold text-slate-800 mb-2">Drop your .MBOX or Google Takeout archive here</h2>
    <p class="text-slate-500 max-w-lg mx-auto mb-6 text-sm">
      Supports files up to 10GB+. Indexed in memory using chunked streaming. Your emails never leave your computer.
    </p>

    <button type="button" class="bg-sky-600 hover:bg-sky-700 text-white font-semibold px-6 py-2.5 rounded-full shadow-sm transition text-sm cursor-pointer" id="btn-browse-file">
      Select MBOX File
    </button>

    <div class="mt-6 flex flex-wrap justify-center items-center gap-4 text-xs text-slate-400">
      <span class="flex items-center gap-1.5 text-emerald-600 font-semibold">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        100% Local &amp; Offline-Safe — Zero bytes uploaded. Disconnect Wi-Fi to verify.
      </span>
      <span>•</span>
      <span class="flex items-center gap-1.5 text-emerald-600 font-medium">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Handles 10GB+ Without Crashing
      </span>
      </span>
    </div>
  </div>

  <!-- 2. Indexing / Streaming Progress Screen (Hidden initially) -->
  <div class="indexing-section hidden bg-white border border-slate-200 rounded-2xl p-8 text-center" id="mbox-indexing-panel">
    <div class="w-12 h-12 mx-auto mb-4 border-4 border-sky-200 border-t-sky-600 rounded-full animate-spin"></div>
    <h3 class="text-lg font-bold text-slate-800 mb-1" id="indexing-title">Indexing MBOX Archive...</h3>
    <p class="text-sm text-slate-500 mb-4" id="indexing-status">Scanning message boundaries (0 emails found)</p>
    
    <div class="w-full max-w-md mx-auto bg-slate-100 rounded-full h-2.5 overflow-hidden">
      <div class="bg-sky-600 h-2.5 rounded-full transition-all duration-150" id="indexing-progress-bar" style="width: 0%"></div>
    </div>
    <p class="text-xs text-slate-400 mt-2" id="indexing-percent">0% scanned</p>
  </div>

  <!-- 3. Dual-Pane Email Workspace (Hidden initially) -->
  <div class="workspace-section hidden grid grid-cols-1 lg:grid-cols-12 gap-6" id="mbox-workspace">
    <!-- Left Column: Search & Message List (5 cols) -->
    <div class="lg:col-span-5 bg-white border border-slate-200 rounded-2xl flex flex-col h-[750px] overflow-hidden shadow-sm">
      <!-- Search & Filters Header -->
      <div class="p-3 border-b border-slate-200 bg-slate-50">
        <div class="relative">
          <input 
            type="text" 
            placeholder="Search sender, subject, date..." 
            class="w-full pl-9 pr-3 py-1.5 text-sm bg-white border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500" 
            id="mbox-search-input"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <div class="flex justify-between items-center mt-2 text-xs text-slate-500 px-1">
          <span id="filtered-count">Showing 0 emails</span>
          <button type="button" class="text-sky-600 hover:text-sky-700 font-medium cursor-pointer" id="btn-reset-archive">Change Archive</button>
        </div>
      </div>

      <!-- Email List Container -->
      <div class="flex-1 overflow-y-auto divide-y divide-slate-100" id="email-list-container">
        <!-- Rendered dynamically -->
      </div>
    </div>

    <!-- Right Column: Email Reader & Security Frame (7 cols) -->
    <div class="lg:col-span-7 bg-white border border-slate-200 rounded-2xl flex flex-col h-[750px] overflow-hidden shadow-sm">
      <!-- Message Header Toolbar -->
      <div class="p-4 border-b border-slate-200 bg-slate-50 flex justify-between items-start gap-4">
        <div class="flex-1 min-w-0">
          <h2 class="text-base font-bold text-slate-900 truncate" id="view-subject">Select an email to view</h2>
          <div class="text-xs text-slate-500 mt-1 flex flex-wrap gap-x-3 gap-y-1">
            <span><strong>From:</strong> <span id="view-from">—</span></span>
            <span><strong>Date:</strong> <span id="view-date">—</span></span>
          </div>
        </div>

        <div class="flex items-center gap-2 flex-shrink-0">
          <button type="button" class="p-1.5 text-slate-500 hover:text-slate-700 hover:bg-slate-200 rounded-md transition cursor-pointer" id="btn-print-email" title="Print to PDF">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          </button>
          <button type="button" class="p-1.5 text-slate-500 hover:text-slate-700 hover:bg-slate-200 rounded-md transition cursor-pointer" id="btn-download-eml" title="Download .EML">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          </button>
        </div>
      </div>

      <!-- Security / Remote Images Banner -->
      <div class="hidden bg-amber-50 border-b border-amber-200 px-4 py-2 text-xs text-amber-800 flex justify-between items-center" id="remote-images-banner">
        <span>Remote tracking images blocked for your privacy.</span>
        <button type="button" class="text-amber-900 underline font-semibold hover:text-amber-950 cursor-pointer" id="btn-load-remote-images">Load remote images</button>
      </div>

      <!-- Attachments Bar (Hidden if no attachments) -->
      <div class="hidden border-b border-slate-200 bg-slate-50 px-4 py-2 flex items-center gap-2 overflow-x-auto text-xs" id="attachments-bar">
        <span class="font-semibold text-slate-600 flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>
          Attachments:
        </span>
        <div class="flex items-center gap-2 flex-wrap" id="attachments-pills"></div>
      </div>

      <!-- Sandboxed Email Content Body -->
      <div class="flex-1 bg-white relative">
        <iframe 
          id="email-sandbox-frame" 
          sandbox="" 
          class="w-full h-full border-none"
          title="Email Content Preview"
        ></iframe>
      </div>
    </div>
  </div>

  <!-- 4. Offline Privacy Proof Banner -->
  <div class="mt-8 bg-white border border-slate-200 rounded-xl p-4 flex items-start gap-3">
    <div class="text-xl">🛡️</div>
    <div class="text-xs text-slate-600">
      <strong class="text-slate-800 block mb-0.5">Offline-Proof Guarantee</strong>
      Want to verify that your private emails never leave this device? Disconnect your Wi-Fi or turn on Airplane Mode, then drop your .MBOX file. ViewMbox continues running 100% offline in browser memory.
    </div>
  </div>
</div>

<script>
  import PostalMime from 'postal-mime';
  import MboxWorker from '../workers/mbox-worker.js?worker&inline';

  // State
  let currentFile: File | null = null;
  let masterIndex: Array<{ id: number; offset: number; length: number; subject: string; from: string; date: string }> = [];
  let filteredIndex: Array<{ id: number; offset: number; length: number; subject: string; from: string; date: string }> = [];
  let currentRawBlob: Blob | null = null;
  let currentEmailSubject: string = '';
  let activeBlobUrls: string[] = [];
  let mboxWorker: Worker | null = null;

  // DOM Elements
  const dropzone = document.getElementById('mbox-dropzone');
  const fileInput = document.getElementById('mbox-file-input') as HTMLInputElement;
  const btnBrowse = document.getElementById('btn-browse-file');
  const indexingPanel = document.getElementById('mbox-indexing-panel');
  const indexingStatus = document.getElementById('indexing-status');
  const indexingProgressBar = document.getElementById('indexing-progress-bar');
  const indexingPercent = document.getElementById('indexing-percent');
  const workspace = document.getElementById('mbox-workspace');
  const emailListContainer = document.getElementById('email-list-container');
  const searchInput = document.getElementById('mbox-search-input') as HTMLInputElement;
  const filteredCount = document.getElementById('filtered-count');
  const btnReset = document.getElementById('btn-reset-archive');

  const viewSubject = document.getElementById('view-subject');
  const viewFrom = document.getElementById('view-from');
  const viewDate = document.getElementById('view-date');
  const sandboxFrame = document.getElementById('email-sandbox-frame') as HTMLIFrameElement;
  const remoteImagesBanner = document.getElementById('remote-images-banner');
  const btnLoadRemoteImages = document.getElementById('btn-load-remote-images');
  const attachmentsBar = document.getElementById('attachments-bar');
  const attachmentsPills = document.getElementById('attachments-pills');
  const btnPrintEmail = document.getElementById('btn-print-email');
  const btnDownloadEml = document.getElementById('btn-download-eml');

  const zipWarningBox = document.getElementById('zip-warning-box');
  const btnDismissZip = document.getElementById('btn-dismiss-zip-warning');

  btnDismissZip?.addEventListener('click', () => zipWarningBox?.classList.add('hidden'));

  // Memory Leak Prevention: revokes object URLs from previous email
  function cleanupBlobUrls() {
    for (const url of activeBlobUrls) {
      URL.revokeObjectURL(url);
    }
    activeBlobUrls = [];
  }

  // File selection
  btnBrowse?.addEventListener('click', () => fileInput?.click());
  dropzone?.addEventListener('click', (e) => {
    if (e.target !== btnBrowse) fileInput?.click();
  });

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-sky-500', 'bg-sky-50/50');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-sky-500', 'bg-sky-50/50');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-sky-500', 'bg-sky-50/50');
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
      processIncomingFile(e.dataTransfer.files[0]);
    }
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files && fileInput.files.length > 0) {
      processIncomingFile(fileInput.files[0]);
    }
  });

  btnReset?.addEventListener('click', () => {
    cleanupBlobUrls();
    workspace?.classList.add('hidden');
    indexingPanel?.classList.add('hidden');
    dropzone?.classList.remove('hidden');
    fileInput.value = '';
    currentFile = null;
    masterIndex = [];
    filteredIndex = [];
    if (mboxWorker) {
      mboxWorker.terminate();
      mboxWorker = null;
    }
  });

  // Sniff magic bytes for ZIP (50 4B 03 04) or GZIP (1F 8B)
  async function isCompressedArchive(file: File): Promise<boolean> {
    const slice = file.slice(0, 4);
    const buffer = await slice.arrayBuffer();
    const bytes = new Uint8Array(buffer);
    if (bytes[0] === 0x50 && bytes[1] === 0x4B) return true; // ZIP
    if (bytes[0] === 0x1F && bytes[1] === 0x8B) return true; // GZIP
    return false;
  }

  async function processIncomingFile(file: File) {
    // 1. Check for ZIP trap
    const isZip = await isCompressedArchive(file);
    if (isZip || file.name.endsWith('.zip') || file.name.endsWith('.tgz')) {
      zipWarningBox?.classList.remove('hidden');
      return;
    }

    zipWarningBox?.classList.add('hidden');
    currentFile = file;

    dropzone?.classList.add('hidden');
    indexingPanel?.classList.remove('hidden');

    // Spawn inline worker (Blob URL generated by Vite - 100% offline proof)
    if (mboxWorker) mboxWorker.terminate();
    mboxWorker = new MboxWorker();

    mboxWorker.onmessage = (e) => {
      const { type, percent, indexedCount, totalCount, index, buffer, offset } = e.data;

      if (type === 'INDEX_PROGRESS') {
        if (indexingProgressBar) indexingProgressBar.style.width = `${percent}%`;
        if (indexingPercent) indexingPercent.textContent = `${percent}% scanned`;
        if (indexingStatus) indexingStatus.textContent = `Indexed ${indexedCount.toLocaleString()} emails...`;
      } else if (type === 'INDEX_COMPLETE') {
        masterIndex = index;
        filteredIndex = index;
        indexingPanel?.classList.add('hidden');
        workspace?.classList.remove('hidden');
        renderEmailList();

        // Auto-select first email if available
        if (masterIndex.length > 0) {
          selectEmail(0);
        }
      } else if (type === 'MESSAGE_LOADED') {
        renderEmailContent(buffer);
      } else if (type === 'ERROR') {
        alert('Worker error: ' + e.data.message);
        indexingPanel?.classList.add('hidden');
        dropzone?.classList.remove('hidden');
      }
    };

    mboxWorker.postMessage({ type: 'INDEX_FILE', file });
  }

  // Fast keystroke search scoped to in-memory index (<10ms)
  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.toLowerCase().trim();
    if (!q) {
      filteredIndex = masterIndex;
    } else {
      filteredIndex = masterIndex.filter(item => 
        item.subject.toLowerCase().includes(q) || 
        item.from.toLowerCase().includes(q) || 
        item.date.toLowerCase().includes(q)
      );
    }
    renderEmailList();
  });

  function renderEmailList() {
    if (!emailListContainer) return;
    if (filteredCount) {
      filteredCount.textContent = `Showing ${filteredIndex.length.toLocaleString()} of ${masterIndex.length.toLocaleString()} emails`;
    }

    if (filteredIndex.length === 0) {
      emailListContainer.innerHTML = '<div class="p-8 text-center text-xs text-slate-400">No matching emails found</div>';
      return;
    }

    // Render list (showing up to first 500 in viewport; virtualized pagination)
    const displayBatch = filteredIndex.slice(0, 500);
    emailListContainer.innerHTML = displayBatch.map((msg, i) => `
      <div class="email-row p-3 hover:bg-slate-50 cursor-pointer transition text-left" data-index="${i}">
        <div class="flex justify-between items-baseline mb-0.5">
          <span class="text-xs font-semibold text-slate-800 truncate max-w-[200px]">${escapeHTML(msg.from)}</span>
          <span class="text-[10px] text-slate-400 flex-shrink-0">${escapeHTML(msg.date ? msg.date.slice(0, 16) : '')}</span>
        </div>
        <div class="text-xs font-medium text-slate-900 truncate mb-0.5">${escapeHTML(msg.subject)}</div>
      </div>
    `).join('');

    emailListContainer.querySelectorAll('.email-row').forEach(row => {
      row.addEventListener('click', () => {
        const idx = parseInt(row.getAttribute('data-index') || '0', 10);
        selectEmail(idx);
      });
    });
  }

  let selectedIdx = -1;
  function selectEmail(filteredIdx: number) {
    selectedIdx = filteredIdx;
    const msg = filteredIndex[filteredIdx];
    if (!msg || !currentFile || !mboxWorker) return;

    // Highlight row
    document.querySelectorAll('.email-row').forEach((r, i) => {
      if (i === filteredIdx) r.classList.add('bg-sky-50', 'border-l-4', 'border-sky-600');
      else r.classList.remove('bg-sky-50', 'border-l-4', 'border-sky-600');
    });

    if (viewSubject) viewSubject.textContent = msg.subject;
    if (viewFrom) viewFrom.textContent = msg.from;
    if (viewDate) viewDate.textContent = msg.date;

    currentEmailSubject = msg.subject;
    currentRawBlob = currentFile.slice(msg.offset, msg.offset + msg.length);

    // Request worker to read single email buffer
    mboxWorker.postMessage({
      type: 'READ_MESSAGE',
      file: currentFile,
      offset: msg.offset,
      length: msg.length
    });
  }

  // Parse and render email content using PostalMime & CSP Sandbox
  async function renderEmailContent(arrayBuffer: ArrayBuffer) {
    cleanupBlobUrls();

    try {
      const parser = new PostalMime();
      const email = await parser.parse(arrayBuffer);

      // Rewriting cid: inline images
      let bodyHtml = email.html || (email.text ? `<pre style="font-family: inherit; white-space: pre-wrap;">${escapeHTML(email.text)}</pre>` : '<p class="text-slate-400">Empty message</p>');

      if (email.attachments && email.attachments.length > 0) {
        email.attachments.forEach(att => {
          if (att.contentId) {
            const cleanCid = att.contentId.replace(/^<|>$/g, '');
            const blob = new Blob([att.content], { type: att.mimeType });
            const blobUrl = URL.createObjectURL(blob);
            activeBlobUrls.push(blobUrl);
            bodyHtml = bodyHtml.replaceAll('cid:' + cleanCid, blobUrl);
          }
        });
      }

      // Render attachments bar
      if (attachmentsBar && attachmentsPills) {
        const fileAttachments = (email.attachments || []).filter(a => a.disposition !== 'inline' || !a.contentId);
        if (fileAttachments.length > 0) {
          attachmentsBar.classList.remove('hidden');
          attachmentsPills.innerHTML = '';
          fileAttachments.forEach(att => {
            const blob = new Blob([att.content], { type: att.mimeType || 'application/octet-stream' });
            const blobUrl = URL.createObjectURL(blob);
            activeBlobUrls.push(blobUrl);

            const pill = document.createElement('a');
            pill.href = blobUrl;
            pill.download = att.filename || 'attachment';
            pill.className = 'px-2 py-0.5 bg-white border border-slate-300 rounded text-[11px] text-sky-700 hover:bg-slate-50 flex items-center gap-1 font-medium';
            pill.innerHTML = `<span>📎 ${escapeHTML(att.filename || 'file')}</span><span class="text-[10px] text-slate-400">(${(att.content.byteLength / 1024).toFixed(0)} KB)</span>`;
            attachmentsPills.appendChild(pill);
          });
        } else {
          attachmentsBar.classList.add('hidden');
        }
      }

      // Injected CSP strictly blocks external tracking pixels (img-src data: blob:;)
      const csp = `<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data: blob:;">`;
      const docHtml = `
        <!DOCTYPE html>
        <html>
          <head>
            <meta charset="utf-8">
            ${csp}
            <style>
              body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 14px; line-height: 1.5; color: #1e293b; padding: 1.5rem; }
              img { max-width: 100%; height: auto; }
            </style>
          </head>
          <body>${bodyHtml}</body>
        </html>
      `;

      if (sandboxFrame) {
        sandboxFrame.srcdoc = docHtml;
      }

    } catch (err) {
      if (sandboxFrame) {
        sandboxFrame.srcdoc = `<p style="padding: 1rem; color: #dc2626;">Error parsing email structure: ${escapeHTML(String(err))}</p>`;
      }
    }
  }

  // 5-line Download .EML
  btnDownloadEml?.addEventListener('click', () => {
    if (!currentRawBlob) return;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(currentRawBlob);
    a.download = `${(currentEmailSubject || 'message').replace(/[^a-zA-Z0-9_-]/g, '_')}.eml`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  });

  // 5-line Print to PDF
  btnPrintEmail?.addEventListener('click', () => {
    sandboxFrame?.contentWindow?.print();
  });

  function escapeHTML(str: string): string {
    return str.replace(/[&<>'"]/g, tag => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;'
    }[tag] || tag));
  }
</script>
