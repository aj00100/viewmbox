---
// src/components/MboxApp.astro
---
<section id="mbox-app" class="max-w-7xl mx-auto p-4">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm text-emerald-900">
    <strong>100% Local &amp; Offline-Safe</strong>
    <span>Zero bytes uploaded. Disconnect Wi-Fi before dropping a file to verify.</span>
  </div>

  <!-- Dropzone -->
  <div
    id="dropzone"
    class="cursor-pointer rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 p-10 text-center transition hover:border-blue-500"
  >
    <input id="file-input" type="file" accept=".mbox,.mbx,.eml,.txt,.zip,.gz" class="hidden" />
    <p class="text-lg font-semibold text-slate-800">Drop your .mbox file here (up to 50GB+)</p>
    <p class="mt-1 text-sm text-slate-500">Google Takeout, Thunderbird, Apple Mail — processed locally in your browser</p>
  </div>

  <!-- ZIP / GZIP Warning Banner -->
  <div id="zip-warning" class="mt-4 hidden rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
    <strong>Google Takeout Archive Detected:</strong> You dropped a compressed ZIP/GZIP file.
    Extract it first, then drop the <code>.mbox</code> file from <code>Takeout/Mail/</code> here.
  </div>

  <!-- Progress Bar -->
  <div id="progress-wrap" class="mt-4 hidden">
    <div class="flex justify-between text-xs text-slate-600 mb-1">
      <span id="progress-label">Scanning...</span>
      <span id="progress-pct">0%</span>
    </div>
    <div class="h-2 w-full rounded bg-slate-200 overflow-hidden">
      <div id="progress-bar" class="h-full bg-blue-600 transition-all" style="width:0%"></div>
    </div>
  </div>

  <!-- Viewer Split Pane -->
  <div id="viewer" class="mt-6 hidden grid grid-cols-1 gap-4 lg:grid-cols-12">
    <aside class="lg:col-span-4 flex flex-col border rounded-lg bg-white h-[75vh]">
      <div class="p-3 border-b">
        <input
          id="search-input"
          type="search"
          placeholder="Filter subject, sender, date..."
          class="w-full rounded border border-slate-300 px-3 py-1.5 text-sm"
        />
        <div id="count-label" class="mt-1 text-xs text-slate-500">0 emails</div>
      </div>
      <div id="email-list" class="flex-1 overflow-y-auto divide-y divide-slate-100"></div>
    </aside>

    <main class="lg:col-span-8 flex flex-col border rounded-lg bg-white h-[75vh]">
      <div id="email-header" class="border-b p-4 hidden">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div>
            <h2 id="view-subject" class="text-lg font-bold text-slate-900"></h2>
            <p id="view-from" class="text-xs text-slate-600 mt-1"></p>
            <p id="view-date" class="text-xs text-slate-400"></p>
          </div>
          <div class="flex gap-2">
            <button id="btn-remote-img" class="rounded border px-2.5 py-1 text-xs hover:bg-slate-50 cursor-pointer">
              Load Remote Images
            </button>
            <button id="btn-download-eml" class="rounded border px-2.5 py-1 text-xs hover:bg-slate-50 cursor-pointer">
              Download .EML
            </button>
            <button id="btn-print" class="rounded bg-slate-900 px-2.5 py-1 text-xs text-white hover:bg-slate-700 cursor-pointer">
              Print / PDF
            </button>
          </div>
        </div>
        <div id="attachments-bar" class="mt-3 flex flex-wrap gap-2"></div>
      </div>
      <iframe id="email-frame" sandbox="allow-modals" class="flex-1 w-full bg-white"></iframe>
    </main>
  </div>
</section>

<script>
  // Inline worker into bundle so it works 100% offline with zero network fetch
  import MboxWorker from '../workers/mbox-worker.ts?worker&inline';
  import type { EmailIndexItem } from '../workers/mbox-worker';
  import { renderEmailFromSlice, downloadRawEml } from '../lib/email-renderer';

  const dropzone = document.getElementById('dropzone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const zipWarning = document.getElementById('zip-warning')!;
  const progressWrap = document.getElementById('progress-wrap')!;
  const progressBar = document.getElementById('progress-bar')!;
  const progressLabel = document.getElementById('progress-label')!;
  const progressPct = document.getElementById('progress-pct')!;
  const viewer = document.getElementById('viewer')!;
  const emailList = document.getElementById('email-list')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const countLabel = document.getElementById('count-label')!;
  const emailHeader = document.getElementById('email-header')!;
  const emailFrame = document.getElementById('email-frame') as HTMLIFrameElement;
  const attachmentsBar = document.getElementById('attachments-bar')!;

  let worker: Worker | null = null;
  let currentFile: File | null = null;
  let allEmails: EmailIndexItem[] = [];
  let selectedEmail: EmailIndexItem | null = null;

  async function isCompressedArchive(file: File): Promise<boolean> {
    const head = new Uint8Array(await file.slice(0, 4).arrayBuffer());
    const isZip = head[0] === 0x50 && head[1] === 0x4b && head[2] === 0x03 && head[3] === 0x04;
    const isGzip = head[0] === 0x1f && head[1] === 0x8b;
    return isZip || isGzip;
  }

  function renderList(items: EmailIndexItem[]) {
    countLabel.textContent = `${items.length.toLocaleString()} emails`;
    // Render first 300 rows at a time to keep DOM instant
    const slice = items.slice(0, 300);
    const frag = document.createDocumentFragment();

    for (const item of slice) {
      const btn = document.createElement('button');
      btn.className = 'w-full text-left p-3 hover:bg-blue-50 focus:bg-blue-50 transition cursor-pointer';
      btn.innerHTML = `
        <div class="truncate text-sm font-semibold text-slate-900"></div>
        <div class="truncate text-xs text-slate-600 mt-0.5"></div>
        <div class="truncate text-[11px] text-slate-400 mt-0.5"></div>
      `;
      btn.children[0].textContent = item.subject;
      btn.children[1].textContent = item.from;
      btn.children[2].textContent = item.date;
      btn.onclick = () => openEmail(item, false);
      frag.appendChild(btn);
    }

    emailList.innerHTML = '';
    emailList.appendChild(frag);
  }

  async function openEmail(item: EmailIndexItem, allowRemoteImages: boolean) {
    if (!currentFile) return;
    selectedEmail = item;
    const rendered = await renderEmailFromSlice(currentFile, item.start, item.end, allowRemoteImages);

    emailHeader.classList.remove('hidden');
    document.getElementById('view-subject')!.textContent = rendered.subject;
    document.getElementById('view-from')!.textContent = `From: ${rendered.from}`;
    document.getElementById('view-date')!.textContent = rendered.date;

    attachmentsBar.innerHTML = '';
    for (const att of rendered.attachments) {
      const a = document.createElement('a');
      a.href = att.url;
      a.download = att.filename;
      a.className = 'rounded bg-slate-100 px-2 py-1 text-xs text-slate-700 hover:bg-slate-200';
      a.textContent = `📎 ${att.filename} (${Math.max(1, Math.round(att.size / 1024))} KB)`;
      attachmentsBar.appendChild(a);
    }

    emailFrame.srcdoc = rendered.srcdoc;
  }

  async function handleFile(file: File) {
    zipWarning.classList.add('hidden');
    if (await isCompressedArchive(file)) {
      zipWarning.classList.remove('hidden');
      return;
    }

    if (worker) worker.terminate();
    currentFile = file;
    allEmails = [];
    selectedEmail = null;

    progressWrap.classList.remove('hidden');
    viewer.classList.remove('hidden');
    progressBar.style.width = '0%';

    worker = new MboxWorker();
    worker.onmessage = (e: MessageEvent) => {
      const msg = e.data;
      if (msg.type === 'PROGRESS') {
        progressLabel.textContent = `Scanning ${file.name} (${msg.found.toLocaleString()} emails found)...`;
        progressPct.textContent = `${msg.percent}%`;
        progressBar.style.width = `${msg.percent}%`;
      } else if (msg.type === 'BATCH') {
        allEmails.push(...msg.items);
        progressLabel.textContent = `Indexing headers (${allEmails.length.toLocaleString()})...`;
        progressPct.textContent = `${msg.percent}%`;
        progressBar.style.width = `${msg.percent}%`;
        if (allEmails.length <= 300) renderList(allEmails);
      } else if (msg.type === 'DONE') {
        progressWrap.classList.add('hidden');
        renderList(allEmails);
        if (allEmails.length > 0) openEmail(allEmails[0], false);
      }
    };

    worker.postMessage({ type: 'INDEX', file });
  }

  dropzone.onclick = () => fileInput.click();
  fileInput.onchange = () => fileInput.files?.[0] && handleFile(fileInput.files[0]);
  dropzone.ondragover = (e) => e.preventDefault();
  dropzone.ondrop = (e) => {
    e.preventDefault();
    const f = e.dataTransfer?.files?.[0];
    if (f) handleFile(f);
  };

  searchInput.oninput = () => {
    const q = searchInput.value.trim().toLowerCase();
    if (!q) return renderList(allEmails);
    const filtered = allEmails.filter(
      (m) =>
        m.subject.toLowerCase().includes(q) ||
        m.from.toLowerCase().includes(q) ||
        m.date.toLowerCase().includes(q)
    );
    renderList(filtered);
  };

  document.getElementById('btn-remote-img')!.onclick = () => {
    if (selectedEmail) openEmail(selectedEmail, true);
  };
  document.getElementById('btn-download-eml')!.onclick = () => {
    if (currentFile && selectedEmail) {
      downloadRawEml(currentFile, selectedEmail.start, selectedEmail.end, selectedEmail.subject);
    }
  };
  document.getElementById('btn-print')!.onclick = () => {
    emailFrame.contentWindow?.print();
  };
</script>
